---
interface Props {
  kicker: string;
  title: string;
  /** Alignement du bloc titre. */
  align?: "left" | "center";
  /** Lien optionnel affiché à droite du titre (ex. "Toutes nos actualités"). */
  actionLabel?: string;
  actionHref?: string;
}
import { rel } from "../lib/base";

const { kicker, title, align = "left", actionLabel, actionHref } = Astro.props;
---
<div class:list={["section-head wrap", `is-${align}`]}>
  <div class="sh-row">
    <div class="sh-titles">
      <div class="kicker">{kicker}</div>
      <h2>{title}</h2>
    </div>

    {
      actionHref && (
        <a class="sh-action" href={rel(actionHref)}>{actionLabel ?? "Voir tout"}</a>
      )
    }
  </div>
</div>

<style>
  .section-head {
    padding-top: 60px;
    padding-bottom: 32px;
  }
  .sh-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  .kicker {
    font-size: 11px;
    font-weight: 800;
    letter-spacing: .12em;
    color: var(--color-ink);
  }
  h2 {
    margin-top: 8px;
    max-width: 20ch;
    font-family: var(--font-display);
    font-size: clamp(34px, 3.3vw, 48px);
    font-weight: 800;
    letter-spacing: -0.05em;
    line-height: .98;
  }

  /* Variante centrée */
  .is-center .sh-row {
    flex-direction: column;
    justify-content: center;
    text-align: center;
  }
  .is-center h2 {
    max-width: 28ch;
    margin-left: auto;
    margin-right: auto;
    text-wrap: balance;
  }

  .sh-action {
    flex-shrink: 0;
    display: inline-block;
    padding: 10px 0;
    border-bottom: 1px solid currentColor;
    color: var(--color-ink);
    font-size: 13px;
    font-weight: 700;
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .sh-action:hover {
    color: var(--color-ink);
    border-bottom-color: var(--color-yellow);
  }

  @media (max-width: 640px) {
    h2 {
      font-size: 28px;
    }
  }
</style>
