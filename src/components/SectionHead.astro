---
interface Props {
  kicker: string;
  title: string;
  /** Alignement du bloc titre. */
  align?: "left" | "center";
  /** Lien optionnel affiché à droite du titre (ex. "Toutes nos actualités"). */
  actionLabel?: string;
  actionHref?: string;
}
import { rel } from "../lib/base";

const { kicker, title, align = "left", actionLabel, actionHref } = Astro.props;
---
<div class:list={["section-head wrap", `is-${align}`]}>
  <div class="sh-row">
    <div class="sh-titles">
      <div class="kicker">{kicker}</div>
      <h2>{title}</h2>
    </div>

    {
      actionHref && (
        <a class="sh-action" href={rel(actionHref)} aria-label={actionLabel ?? "Voir tout"}>
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path
              d="M5 12h14M13 6l6 6-6 6"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </a>
      )
    }
  </div>
</div>

<style>
  .section-head {
    padding-top: 60px;
    padding-bottom: 32px;
  }
  .sh-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  .kicker {
    font-size: 14px;
    font-weight: 700;
    color: var(--color-teal);
  }
  h2 {
    margin-top: 8px;
    max-width: 20ch;
    font-family: var(--font-display);
    font-size: 34px;
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  /* Variante centrée */
  .is-center .sh-row {
    flex-direction: column;
    justify-content: center;
    text-align: center;
  }
  .is-center h2 {
    max-width: 28ch;
    margin-left: auto;
    margin-right: auto;
    text-wrap: balance;
  }

  .sh-action {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 54px;
    height: 54px;
    border: 1px solid var(--color-ink);
    border-radius: 50%;
    color: var(--color-ink);
    text-decoration: none;
    transition: background 0.2s ease, color 0.2s ease;
  }
  .sh-action svg {
    width: 20px;
    height: 20px;
    transition: transform 0.2s ease;
  }
  .sh-action:hover {
    background: var(--color-ink);
    color: var(--color-paper);
  }
  .sh-action:hover svg {
    transform: translateX(3px);
  }

  @media (max-width: 640px) {
    h2 {
      font-size: 28px;
    }
    .sh-action {
      width: 46px;
      height: 46px;
    }
  }
</style>
