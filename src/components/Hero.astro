---
import { Image } from "astro:assets";
import heroImage from "../assets/hero-ligne-production-v3.png";
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__image">
    <Image
      src={heroImage}
      alt="Bouteilles PET Nice Emballage sur une ligne de production"
      widths={[800, 1200, 1600, 2000]}
      sizes="100vw"
    />
  </div>
  <div class="hero__shade" aria-hidden="true"></div>

  <div class="hero__content wrap">
    <h1 id="hero-title">L’emballage, fabriqué ici.</h1>
  </div>
  <a class="hero__scroll" href="#nos-emballages" aria-label="Faire défiler vers nos emballages">
    <i aria-hidden="true"></i>
  </a>
</section>

<style>
  .hero {
    position:relative;
    isolation:isolate;
    display:grid;
    min-height:clamp(610px, 82vh, 920px);
    overflow:hidden;
    background:var(--color-ink);
    color:var(--color-paper);
  }
  .hero__image, .hero__shade { grid-area:1 / 1; width:100%; height:100%; }
  .hero__image :global(img) { display:block; width:100%; height:100%; object-fit:cover; object-position:center; }
  .hero__shade { background:linear-gradient(90deg, rgba(10,12,12,.88) 0%, rgba(10,12,12,.72) 34%, rgba(10,12,12,.2) 58%, rgba(10,12,12,0) 76%); }
  .hero__content { z-index:1; grid-area:1 / 1; align-self:center; width:100%; padding-top:38px; }
  h1 { max-width:9ch; margin:0; font-family:var(--font-display); font-size:clamp(4rem,7.4vw,8.2rem); font-weight:800; letter-spacing:-.08em; line-height:.84; }
  .hero__scroll { position:absolute; z-index:1; bottom:34px; left:50%; display:block; padding:8px; transform:translateX(-50%); color:rgba(245,244,240,.78); text-decoration:none; }
  .hero__scroll i { display:block; width:1px; height:34px; background:currentColor; animation:scroll-hint 1.8s ease-in-out infinite; }
  @keyframes scroll-hint { 0%, 100% { transform:scaleY(.45); transform-origin:top; opacity:.45; } 50% { transform:scaleY(1); transform-origin:top; opacity:1; } }

  @media (max-width:800px) {
    .hero { min-height:100vh; min-height:100svh; }
    .hero__image :global(img) { object-position:78% center; }
    .hero__shade { background:linear-gradient(90deg, rgba(10,12,12,.92) 0%, rgba(10,12,12,.74) 66%, rgba(10,12,12,.22) 100%); }
    .hero__content { align-self:end; padding-bottom:68px; }
    h1 { max-width:8ch; font-size:clamp(3.5rem,14vw,5.2rem); }
    .hero__scroll { display:none; }
  }
  @media (max-width:480px) {
    .hero__image :global(img) { object-position:82% center; }
  }
</style>
