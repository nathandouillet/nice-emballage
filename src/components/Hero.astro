---
import { Image } from "astro:assets";
import heroImg from "../assets/hero-bouteilles.png";
import { rel } from "../lib/base";
---
<section class="hero">
  <div class="hero-primary wrap">
    <h1>L’emballage, fabriqué ici.</h1>
    <div class="hero-graphic">
      <Image src={heroImg} alt="Bouteilles en plastique Nice Emballage" />
    </div>
  </div>
  <div class="hero-secondary wrap">
    <p>Préformes, bouchons, bouteilles et emballages plastiques à Ouagadougou.</p>
    <a href={rel("/contact")} class="btn-primary">Parlons de votre besoin</a>
  </div>
</section>

<style>
  .hero { padding:88px 0 96px; }
  .hero-primary {
    display: grid;
    grid-template-columns: .82fr 1.18fr;
    gap: clamp(36px, 5vw, 88px);
    align-items: center;
    min-height: 510px;
  }
  h1 {
    font-family: var(--font-display);
    max-width: 9ch;
    font-size: clamp(56px, 6.2vw, 96px);
    font-weight: 800;
    letter-spacing: -0.06em;
    line-height: .94;
  }
  .hero-graphic {
    position: relative;
    align-self: stretch;
    min-height: 470px;
    margin-right: calc(var(--gutter) * -1);
    overflow: hidden;
    border-radius: 22px;
    background: var(--color-stone);
  }
  .hero-graphic img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .hero-secondary { margin-top:96px; text-align:center; }
  .hero-secondary p { max-width:26ch; margin:0 auto; color:var(--color-ink); font-family:var(--font-display); font-size:clamp(28px,3.1vw,46px); font-weight:500; letter-spacing:-.05em; line-height:1.04; }
  .hero-secondary a { display:inline-block; margin-top:30px; }

  @media (max-width: 860px) {
    .hero { padding-top:64px; padding-bottom:72px; }
    .hero-primary {
      grid-template-columns: 1fr;
      gap: 36px;
      min-height: 0;
    }
    h1 {
      font-size: 40px;
    }
    .hero-graphic {
      min-height: 0;
      aspect-ratio: 4 / 3;
      margin-right: 0;
      max-width: 420px;
    }
    .hero-secondary { margin-top:56px; }
  }
</style>
