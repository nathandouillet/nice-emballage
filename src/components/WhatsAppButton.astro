---
interface Props {
  label?: string;
  href?: string;
  /** "full" = bouton vert plein (panneau contact) · "compact" = version footer */
  variant?: "full" | "compact";
}
const {
  label = "Discuter sur WhatsApp",
  href = "https://wa.me/22664986666",
  variant = "full",
} = Astro.props;
---
<a href={href} class:list={["wa", variant]} target="_blank" rel="noopener">
  <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path
      d="M17.6 6.32A8.86 8.86 0 0 0 12.05 4c-4.92 0-8.92 4-8.92 8.92a8.87 8.87 0 0 0 1.19 4.46L3 22l4.76-1.25a8.9 8.9 0 0 0 4.27 1.09h.01c4.92 0 8.92-4 8.92-8.92a8.86 8.86 0 0 0-3.36-6.6zm-5.55 13.72h-.01a7.4 7.4 0 0 1-3.77-1.03l-.27-.16-2.82.74.75-2.75-.18-.28a7.38 7.38 0 0 1-1.13-3.94c0-4.08 3.32-7.4 7.4-7.4a7.36 7.36 0 0 1 5.24 2.17 7.36 7.36 0 0 1 2.17 5.24c0 4.08-3.32 7.4-7.38 7.4zm4.05-5.54c-.22-.11-1.31-.65-1.52-.72-.2-.07-.35-.11-.5.11-.15.22-.57.72-.7.87-.13.15-.26.17-.48.06-.22-.11-.94-.35-1.79-1.11-.66-.59-1.11-1.32-1.24-1.54-.13-.22-.01-.34.1-.45.1-.1.22-.26.33-.39.11-.13.15-.22.22-.37.07-.15.04-.28-.02-.39-.06-.11-.5-1.21-.69-1.66-.18-.43-.36-.37-.5-.38-.13-.01-.28-.01-.43-.01a.83.83 0 0 0-.6.28c-.2.22-.79.77-.79 1.87s.81 2.17.92 2.32c.11.15 1.6 2.44 3.87 3.42.54.23.96.37 1.29.48.54.17 1.03.15 1.42.09.43-.06 1.31-.54 1.5-1.05.18-.51.18-.95.13-1.05-.05-.1-.2-.16-.42-.27z"
    ></path>
  </svg>
  {label}
</a>

<style>
  .wa {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    width: fit-content;
    background: var(--color-whatsapp);
    color: #fff;
    border-radius: var(--radius-pill);
    font-weight: 700;
    text-decoration: none;
    transition: background 0.2s ease;
  }
  .wa:hover {
    background: var(--color-whatsapp-hover);
  }
  .wa svg {
    flex-shrink: 0;
  }

  .wa.full {
    gap: 10px;
    margin-top: 8px;
    padding: 12px 22px 12px 16px;
    font-size: 14px;
  }
  .wa.full svg {
    width: 20px;
    height: 20px;
  }

  .wa.compact {
    gap: 8px;
    margin-top: 4px;
    padding: 11px 20px 11px 14px;
    font-size: 14px;
  }
  .wa.compact svg {
    width: 18px;
    height: 18px;
  }
</style>
