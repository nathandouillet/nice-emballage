---
import { Image } from "astro:assets";
import machineMoule from "../assets/machine-atelier-unifiee.png";
import machineConditionnement from "../assets/machine-sceller-unifiee.png";
import { rel } from "../lib/base";

const equipment = [
  {
    image: machineMoule,
    title: "Moulage & fabrication",
    detail: "Des équipements pour développer votre production.",
  },
  {
    image: machineConditionnement,
    title: "Film & conditionnement",
    detail: "Des solutions adaptées à vos besoins et vos volumes.",
  },
];
---

<section class="machines" aria-labelledby="machines-title">
  <div class="machines__trame" aria-hidden="true"></div>
  <div class="wrap">
    <header class="machines__head">
      <h2 id="machines-title">L’équipement pour aller plus loin.</h2>
    </header>

    <div class="machine-tiles">
      {
        equipment.map((item) => (
          <article class="machine-tile">
            <Image
              src={item.image}
              alt={item.title}
              widths={[760, 1200]}
              sizes="(max-width: 760px) 100vw, 60vw"
            />
            <div class="machine-tile__shade" />
            <div class="machine-tile__content">
              <h3>{item.title}</h3>
              <p>{item.detail}</p>
            </div>
          </article>
        ))
      }
    </div>

    <div class="machines__cta">
      <a href={rel("/contact")}>Parlons de votre besoin</a>
    </div>
  </div>
</section>

<style>
  .machines {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: 112px 0;
    background: var(--color-paper);
  }
  .machines__trame {
    position: absolute;
    z-index: -1;
    inset: -10% -6% -10% 28%;
    opacity: 0.72;
    background-image:
      linear-gradient(90deg, rgba(240, 180, 41, 0.22) 2px, transparent 2px),
      linear-gradient(rgba(240, 180, 41, 0.22) 2px, transparent 2px);
    background-size: 25px 25px;
    transform: skewX(-9deg);
    transform-origin: right center;
    mask-image: radial-gradient(
      ellipse 92% 78% at 88% 52%,
      #000 0%,
      rgba(0, 0, 0, 0.86) 58%,
      transparent 100%
    );
    pointer-events: none;
  }
  .machines__head {
    display: flex;
    justify-content: center;
    margin-bottom: 62px;
    text-align: center;
  }
  .machines__head h2 {
    max-width: 13ch;
    font-family: var(--font-display);
    font-size: clamp(46px, 5.7vw, 88px);
    font-weight: 800;
    letter-spacing: -0.07em;
    line-height: 0.9;
  }
  .machine-tiles {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 22px;
    min-height: 500px;
    transition: grid-template-columns 0.55s cubic-bezier(0.2, 0.75, 0.2, 1);
  }
  .machine-tiles:has(.machine-tile:first-child:hover) {
    grid-template-columns: 1.45fr 0.55fr;
  }
  .machine-tiles:has(.machine-tile:last-child:hover) {
    grid-template-columns: 0.55fr 1.45fr;
  }
  .machine-tile {
    position: relative;
    min-width: 0;
    overflow: hidden;
    border-radius: 22px;
    background: var(--color-stone);
    cursor: default;
  }
  .machine-tile :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.65s ease;
  }
  .machine-tile:hover :global(img) {
    transform: scale(1.035);
  }
  .machine-tile__shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(10, 12, 10, 0.08) 25%,
      rgba(10, 12, 10, 0.78) 100%
    );
  }
  .machine-tile__content {
    position: absolute;
    right: clamp(22px, 3vw, 42px);
    bottom: clamp(22px, 3vw, 42px);
    left: clamp(22px, 3vw, 42px);
    color: #fff;
  }
  .machine-tile h3 {
    max-width: 14ch;
    font-family: var(--font-display);
    font-size: clamp(28px, 3.1vw, 48px);
    letter-spacing: -0.06em;
    line-height: 0.95;
  }
  .machine-tile p {
    max-width: 32ch;
    margin-top: 12px;
    color: rgba(255, 255, 255, 0.78);
    font-size: 14px;
    line-height: 1.45;
    opacity: 0;
    transform: translateY(8px);
    transition:
      opacity 0.3s ease,
      transform 0.3s ease;
  }
  .machine-tile:hover p {
    opacity: 1;
    transform: translateY(0);
  }
  .machines__cta {
    display: flex;
    justify-content: center;
    padding-top: 48px;
  }
  .machines__cta a {
    display: inline-block;
    padding: 15px 24px;
    border-radius: var(--radius-pill);
    background: var(--color-yellow);
    color: var(--color-ink);
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
  }
  .machines__cta a:hover {
    background: var(--color-ink);
    color: var(--color-paper);
  }
  @media (max-width: 760px) {
    .machines {
      padding: 80px 0;
    }
    .machines__trame {
      inset: -8% -30% -8% 8%;
      background-size: 25px 25px;
      transform: skewX(-7deg);
    }
    .machines__head {
      margin-bottom: 40px;
    }
    .machine-tiles,
    .machine-tiles:has(.machine-tile:first-child:hover),
    .machine-tiles:has(.machine-tile:last-child:hover) {
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: calc(100% - 34px);
      width: calc(100% + var(--gutter));
      min-height: 420px;
      margin-right: calc(var(--gutter) * -1);
      padding-right: var(--gutter);
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
    }
    .machine-tiles::-webkit-scrollbar {
      display: none;
    }
    .machine-tile {
      min-height: 420px;
      border-radius: 18px;
      scroll-snap-align: start;
    }
    .machine-tile p {
      opacity: 1;
      transform: none;
    }
    .machines__cta {
      padding-top: 36px;
    }
  }
</style>
