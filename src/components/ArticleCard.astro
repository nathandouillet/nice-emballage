---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { rel } from "../lib/base";

interface Props {
  article: CollectionEntry<"articles">;
}
const { article } = Astro.props;
const { title, date, cover } = article.data;

const dateLabel = new Intl.DateTimeFormat("fr-FR", {
  day: "numeric",
  month: "short",
  year: "numeric",
}).format(date);
---
<a class="card" href={rel(`/actualites/${article.id}`)}>
  <div class="card-media">
    <Image src={cover} alt={title} widths={[300, 500, 700]} sizes="(max-width: 640px) 100vw, 380px" />
  </div>
  <div class="card-body">
    <time>{dateLabel}</time>
    <h3>{title}</h3>
  </div>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
  }
  .card-media {
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 22px;
    background: var(--color-stone);
  }
  .card-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .card-body {
    padding: 18px 4px 0;
  }
  time {
    display:block;
    font-size:13px;
    font-weight:700;
    color: var(--color-text-faint);
  }
  h3 {
    margin-top:9px;
    font-family:var(--font-display);
    font-size:clamp(21px,2vw,29px);
    font-weight:800;
    line-height:1.02;
    letter-spacing:-.055em;
  }
</style>
