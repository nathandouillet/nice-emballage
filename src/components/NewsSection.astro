---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import { rel } from "../lib/base";

/* 1 grand article (le plus récent) + 3 suivants dans la colonne de droite */
const articles = (
  await getCollection("articles", ({ data }) => !data.draft)
).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const featured = articles[0];
const sideItems = articles.slice(1, 4);
---
<div class="news-section wrap">
  <a class="news-featured" href={rel(`/actualites/${featured.id}`)}>
    <Image src={featured.data.cover} alt={featured.data.title} />
    <div class="scrim"></div>
    <div class="content">
      <span class="news-pill">{featured.data.category}</span>
      <h3>{featured.data.title}</h3>
    </div>
  </a>

  <div class="news-list">
    {
      sideItems.map((item) => (
        <a class="news-list-item" href={rel(`/actualites/${item.id}`)}>
          <div class="text">
            <span class="news-pill-outline">{item.data.category}</span>
            <h4>{item.data.title}</h4>
          </div>
          <Image class="thumb" src={item.data.cover} alt="" />
        </a>
      ))
    }
  </div>
</div>

<style>
  .news-section {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 48px;
    align-items: stretch;
    margin-bottom: 96px;
  }

  /* --- Grand article --- */
  .news-featured {
    position: relative;
    /* s'étire pour égaler la hauteur des 3 articles de droite ;
       aspect-ratio + min-height servent de garde-fou si la colonne est courte */
    align-self: stretch;
    aspect-ratio: 1 / 1;
    min-height: 440px;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--color-stone);
    text-decoration: none;
    color: inherit;
  }
  .news-featured :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  .news-featured:hover :global(img) {
    transform: scale(1.04);
  }
  .news-featured .scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      transparent 35%,
      rgba(10, 12, 10, 0.82) 100%
    );
  }
  .news-featured .content {
    position: absolute;
    left: 32px;
    right: 32px;
    bottom: 32px;
    z-index: 2;
  }
  .news-featured h3 {
    max-width: 22ch;
    color: #fff;
    font-family: var(--font-display);
    font-size: 30px;
    font-weight: 700;
    line-height: 1.18;
  }
  .news-pill {
    display: inline-block;
    margin-bottom: 14px;
    padding: 6px 14px;
    border-radius: var(--radius-pill);
    background: var(--color-teal);
    color: #fff;
    font-size: 12px;
    font-weight: 700;
  }

  /* --- Colonne de droite : 3 tiers égaux, hauteur alignée sur le grand article --- */
  .news-list {
    display: grid;
    grid-template-rows: repeat(3, 1fr);
    height: 100%;
  }
  .news-list-item {
    display: grid;
    grid-template-columns: 1fr 190px;
    gap: 24px;
    align-items: center;
    min-height: 0;
    padding: 24px 0;
    border-top: 1px solid var(--color-stone);
    text-decoration: none;
    color: inherit;
  }
  .news-list-item:hover h4 {
    color: var(--color-teal);
  }
  .news-list-item:first-child {
    padding-top: 0;
    border-top: none;
  }
  .news-list-item:last-child {
    padding-bottom: 0;
  }
  .news-list-item .text {
    min-width: 0;
  }
  .news-pill-outline {
    display: inline-block;
    margin-bottom: 12px;
    font-size: 12px;
    font-weight: 700;
    color: var(--color-teal);
  }
  .news-list-item h4 {
    font-size: 20px;
    font-weight: 700;
    line-height: 1.3;
  }
  .news-list-item :global(.thumb) {
    align-self: center;
    width: 190px;
    height: 190px;
    max-width: 100%;
    border-radius: 14px;
    object-fit: cover;
  }

  @media (max-width: 860px) {
    .news-section {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .news-featured {
      max-width: 480px;
    }
    .news-list {
      display: flex;
      flex-direction: column;
      gap: 4px;
      height: auto;
    }
    .news-list-item {
      grid-template-columns: 1fr 120px;
    }
    .news-list-item :global(.thumb) {
      width: 120px;
      height: 120px;
    }
  }
</style>
