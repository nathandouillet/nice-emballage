---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import { rel } from "../lib/base";

const articles = (
  await getCollection("articles", ({ data }) => !data.draft)
).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const homeArticles = articles.slice(0, 4);
---

<div class="news-carousel">
  <header class="news-carousel__head wrap">
    <h2>Les dernières nouvelles de Nice Emballage</h2>
  </header>

  <div class="news-grid wrap" aria-label="Dernières actualités">
    {
      homeArticles.map((article) => (
        <a class="news-card" href={rel(`/actualites/${article.id}`)}>
          <div class="news-card__image">
            <Image src={article.data.cover} alt={article.data.title} />
          </div>
          <h3>{article.data.title}</h3>
        </a>
      ))
    }
  </div>

  <div class="news-carousel__cta">
    <a href={rel("/actualites")}>Toutes nos actualités</a>
  </div>
</div>

<style>
  .news-carousel { overflow:hidden; }
  .news-carousel__head { padding-top:0; padding-bottom:48px; text-align:center; }
  .news-carousel__head h2 { max-width:20ch; margin:0 auto; font-family:var(--font-display); font-size:clamp(38px,4.4vw,66px); font-weight:800; letter-spacing:-.06em; line-height:.94; }
  .news-grid { display:grid; grid-template-columns:repeat(4, 1fr); gap:24px; }
  .news-card { min-width:0; color:var(--color-ink); text-decoration:none; }
  .news-card__image { position:relative; aspect-ratio:1; overflow:hidden; border-radius:24px; background:var(--color-stone); }
  .news-card__image :global(img) { display:block; width:100%; height:100%; object-fit:cover; transition:transform .5s ease; }
  .news-card:hover :global(img) { transform:scale(1.04); }
  .news-card h3 { margin:18px 4px 0; font-family:var(--font-display); font-size:clamp(18px,1.55vw,23px); font-weight:700; letter-spacing:-.035em; line-height:1.15; }
  .news-carousel__cta { display:flex; justify-content:center; padding-top:48px; }
  .news-carousel__cta a { display:inline-block; padding:15px 24px; border-radius:var(--radius-pill); background:var(--color-yellow); color:var(--color-ink); font-size:14px; font-weight:700; text-decoration:none; }
  .news-carousel__cta a:hover { background:var(--color-ink); color:var(--color-paper); }
  @media(max-width:900px){ .news-grid { grid-template-columns:repeat(2, 1fr); gap:24px 16px; } }
  @media(max-width:640px){ .news-grid { grid-template-columns:none; grid-auto-flow:column; grid-auto-columns:minmax(76vw, 300px); width:calc(100% + var(--gutter)); margin-right:calc(var(--gutter) * -1); padding-right:var(--gutter); overflow-x:auto; overscroll-behavior-x:contain; scroll-snap-type:x mandatory; scrollbar-width:none; }.news-grid::-webkit-scrollbar { display:none; }.news-card { scroll-snap-align:start; }.news-carousel__head { padding-bottom:34px; }.news-card__image { border-radius:18px; }.news-carousel__cta { padding-top:36px; } }
</style>
