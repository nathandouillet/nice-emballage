---
import { Image } from "astro:assets";
import logo from "../assets/logo.png";

interface Props {
  /** Variante agrandie (footer). */
  large?: boolean;
}
const { large = false } = Astro.props;
const cls = large ? "logo large" : "logo";
---
<Image class={cls} src={logo} alt="Nice Emballage" densities={[1, 2]} />

<style>
  .logo {
    display: block;
    width: auto;
    height: 112px;
    border-radius: 0;
    box-shadow: none;
  }
  .logo.large {
    height: 112px;
    box-shadow: none;
  }
  @media (max-width: 720px) {
    .logo { height: 72px; }
  }
</style>
