---
import { rel } from "../lib/base";
import { Image } from "astro:assets";
import wordmark from "../assets/logo-wordmark-black-v1.png";
---

<footer id="contact" class="site-footer">
  <div class="footer-inner wrap">
    <div class="footer-top">
      <a
        class="footer-name"
        href={rel("/")}
        aria-label="Nice Emballage — accueil"
        ><Image src={wordmark} alt="Nice Emballage" /></a
      >
      <nav class="footer-links" aria-label="Navigation du pied de page">
        <a href={rel("/produits")}>Emballages</a><a href={rel("/machines")}
          >Machines</a
        ><a href={rel("/contact")}>Nous trouver</a>
      </nav>
    </div>
    <div class="footer-bottom">
      <span>© 2026 Nice Emballage</span><span
        >Fabricant d’emballages plastiques</span
      >
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding: 48px 0 calc(24px + env(safe-area-inset-bottom));
    color: var(--color-ink);
  }
  .footer-top {
    gap: 30px;
    display: flex;
    justify-content: space-between;
  }
  .footer-name {
    display: block;
    line-height: 0;
  }
  .footer-name :global(img) {
    display: block;
    width: auto;
    height: 62px;
  }
  .footer-links {
    display: flex;
    gap: 24px;
    font-size: 13px;
  }
  .footer-links a {
    color: inherit;
    text-decoration: none;
  }
  .footer-links a:hover {
    color: var(--color-teal);
  }
  .footer-bottom {
    display: flex;
    justify-content: space-between;
    gap: 30px;
    margin-top: 56px;
    padding-top: 16px;
    color: var(--color-text-muted);
    font-size: 11px;
  }
  @media (pointer: coarse) {
    .footer-links a {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
    }
  }
  @media (max-width: 760px) {
    .site-footer {
      padding: 44px 0 calc(22px + env(safe-area-inset-bottom));
    }
    .footer-top {
      flex-direction: column;
      align-items: flex-start;
      gap: 26px;
    }
    .footer-bottom {
      display: block;
      margin-top: 42px;
    }
    .footer-bottom span {
      display: block;
      margin-top: 6px;
    }
    .footer-links {
      flex-wrap: wrap;
      gap: 0 22px;
    }
    /* zone tactile confortable (≥ 44px) sans changer le rendu visuel */
    .footer-links a {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
    }
  }
</style>
