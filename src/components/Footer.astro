---
import Logo from "./Logo.astro";
import WhatsAppButton from "./WhatsAppButton.astro";
import { rel } from "../lib/base";
---

<footer class="ft">
  <div class="ft-inner">
    <a href={rel("/")} class="ft-logo" aria-label="Nice Emballage — accueil">
      <Logo />
    </a>

    <nav class="ft-nav">
      <a href={rel("/")}>Accueil</a>
      <a href={rel("/actualites")}>Actualités</a>
      <a href={rel("/contact")}>Contact</a>
    </nav>

    <div class="ft-contact">
      <a href="tel:+22664986666">+226 64 98 66 66</a>
      <a href="mailto:infos@nice-emballage.com">infos@nice-emballage.com</a>
      <WhatsAppButton label="WhatsApp" variant="compact" />
    </div>
  </div>

  <div class="ft-legal">
    <span>© {new Date().getFullYear()} Nice Emballage</span>
    <span>Ouagadougou · Lun–Dim 7h30–18h00</span>
  </div>
</footer>

<style>
  .ft {
    background: var(--color-paper-dim);
    /* border-top: 1px solid var(--color-stone); */
  }
  .ft-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 24px 40px;
    max-width: var(--container);
    margin: 0 auto;
    padding: 64px var(--gutter);
  }
  .ft-logo {
    text-decoration: none;
    color: inherit;
  }
  .ft-nav {
    display: flex;
    gap: 28px;
    font-size: 14px;
    font-weight: 500;
  }
  .ft-nav a {
    color: var(--color-ink);
    text-decoration: none;
  }
  .ft-nav a:hover {
    color: var(--color-teal);
  }
  .ft-contact {
    display: flex;
    align-items: center;
    gap: 20px;
    font-size: 14px;
    font-weight: 600;
  }
  .ft-contact a {
    color: var(--color-ink);
    text-decoration: none;
  }
  .ft-contact a:hover {
    color: var(--color-teal);
  }
  .ft-legal {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px 24px;
    max-width: var(--container);
    margin: 0 auto;
    padding: 16px var(--gutter);
    border-top: 1px solid var(--color-stone);
    font-size: 12.5px;
    color: var(--color-text-faint);
  }

  @media (max-width: 720px) {
    .ft-inner {
      flex-direction: column;
      align-items: flex-start;
    }
    .ft-contact {
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
    }
  }
</style>
