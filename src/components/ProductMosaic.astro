---
import { Image } from "astro:assets";
import preformes from "../assets/preformes-reelles-sombre-v3.png";
import bouchons from "../assets/bouchons-pyramide-sombre.png";
import bouteilles from "../assets/bouteilles-reelles-sombre.png";
import emballages from "../assets/film-emballage-sombre.png";
import { rel } from "../lib/base";

const products = [
  { image: preformes, label: "Préformes" },
  { image: bouchons, label: "Bouchons" },
  { image: bouteilles, label: "Bouteilles" },
  { image: emballages, label: "Emballages" },
];
---

<div class="product-showcase">
  <header class="product-showcase__head wrap">
    <h2>Ce que nous fabriquons</h2>
  </header>

  <div class="product-grid wrap">
    {
      products.map((product) => (
        <article class="product-card">
          <div class="product-card__image">
            <Image src={product.image} alt={product.label} />
          </div>
          <h3>{product.label}</h3>
        </article>
      ))
    }
  </div>

  <p class="product-showcase__lead">Des solutions d’emballage pensées pour vos produits et vos volumes.</p>
  <div class="product-showcase__cta">
    <a href={rel("/produits")}>Découvrir nos produits</a>
  </div>
</div>

<style>
  .product-showcase { overflow:hidden; }
  .product-showcase__head { padding-top:0; padding-bottom:52px; text-align:center; }
  .product-showcase__head h2 { max-width:13ch; margin:0 auto; font-family:var(--font-display); font-size:clamp(46px,5.4vw,82px); font-weight:800; letter-spacing:-.07em; line-height:.9; }
  .product-grid { display:grid; grid-template-columns:repeat(4, 1fr); gap:22px; align-items:start; }
  .product-card { position:relative; }
  .product-card:nth-child(1),.product-card:nth-child(3) { margin-top:64px; }
  .product-card__image { aspect-ratio:1; overflow:hidden; border-radius:22px; background:var(--color-stone); }
  .product-card__image :global(img) { display:block; width:100%; height:100%; object-fit:cover; }
  .product-card h3 { margin:14px 4px 0; font-family:var(--font-display); font-size:clamp(20px,1.8vw,27px); letter-spacing:-.05em; line-height:1; }
  .product-showcase__lead { max-width:44ch; margin:52px auto 0; padding:0 var(--gutter); text-align:center; font-size:15px; font-weight:600; line-height:1.45; }
  .product-showcase__cta { display:flex; justify-content:center; padding-top:24px; }
  .product-showcase__cta a { display:inline-block; padding:15px 24px; border-radius:var(--radius-pill); background:var(--color-yellow); color:var(--color-ink); font-size:14px; font-weight:700; text-decoration:none; }
  .product-showcase__cta a:hover { background:var(--color-ink); color:var(--color-paper); }
  @media(max-width:900px){ .product-grid { grid-template-columns:repeat(2, 1fr); gap:16px; }.product-card:nth-child(1),.product-card:nth-child(3) { margin-top:0; }.product-card:nth-child(2) { margin-top:48px; }.product-showcase__lead { margin-top:40px; } }
  @media(max-width:640px){ .product-grid { grid-template-columns:none; grid-auto-flow:column; grid-auto-columns:minmax(76vw, 300px); width:100vw; margin-right:0; margin-left:calc(50% - 50vw); padding:0 var(--gutter); overflow-x:auto; overscroll-behavior-x:contain; scroll-padding-inline:var(--gutter); scroll-snap-type:x mandatory; scrollbar-width:none; }.product-grid::-webkit-scrollbar { display:none; }.product-card,.product-card:nth-child(2) { margin-top:0; scroll-snap-align:start; }.product-showcase__lead { margin-top:36px; } }
</style>
