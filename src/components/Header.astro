---
import { rel } from "../lib/base";
import { Image } from "astro:assets";
import wordmark from "../assets/logo-wordmark-black-v1.png";
---

<header class="site-header">
  <div class="header-inner wrap">
    <a class="wordmark" href={rel("/")} aria-label="Nice Emballage — accueil"><Image src={wordmark} alt="Nice Emballage" /></a>
    <nav id="site-navigation" aria-label="Navigation principale">
      <a href={rel("/produits")}>Emballages</a>
      <a href={rel("/machines")}>Machines</a>
      <a href={rel("/actualites")}>Actualités</a>
      <a class="nav-mobile-contact" href={rel("/contact")}>Nous contacter</a>
    </nav>
    <a class="header-cta" href={rel("/contact")}>Nous contacter</a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-navigation" aria-label="Ouvrir le menu">
      <span></span><span></span>
    </button>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>(".site-header");
  const toggle = header?.querySelector<HTMLButtonElement>(".menu-toggle");
  const nav = header?.querySelector<HTMLElement>("#site-navigation");

  const updateHeader = () => header?.classList.toggle("is-scrolled", window.scrollY > 20);
  updateHeader();
  window.addEventListener("scroll", updateHeader, { passive: true });

  nav?.querySelectorAll<HTMLAnchorElement>("a").forEach((link) => {
    if (new URL(link.href).pathname === window.location.pathname) {
      link.setAttribute("aria-current", "page");
    }
  });

  const setMenuOpen = (isOpen: boolean) => {
    header?.classList.toggle("menu-open", isOpen);
    toggle?.setAttribute("aria-expanded", String(isOpen));
    toggle?.setAttribute("aria-label", isOpen ? "Fermer le menu" : "Ouvrir le menu");
    document.body.style.overflow = isOpen ? "hidden" : "";
  };

  toggle?.addEventListener("click", () => {
    setMenuOpen(!header?.classList.contains("menu-open"));
  });

  nav?.querySelectorAll("a").forEach((link) => link.addEventListener("click", () => {
    setMenuOpen(false);
  }));
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") setMenuOpen(false);
  });
  window.matchMedia("(max-width: 760px)").addEventListener("change", () => setMenuOpen(false));
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    border-bottom: 1px solid transparent;
    background: rgb(245 244 240 / 0.92);
    backdrop-filter: blur(12px);
    font-size: 16px;
    transition: border-color 0.25s ease, box-shadow 0.25s ease;
  }
  .site-header.is-scrolled {
    border-color: rgb(23 52 58 / 0.12);
    box-shadow: 0 6px 22px rgb(23 52 58 / 0.06);
  }
  .header-inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding-top: 20px;
    padding-bottom: 20px;
    transition: padding 0.25s ease;
  }
  .site-header.is-scrolled .header-inner { padding-top: 12px; padding-bottom: 12px; }
  .wordmark { display:block; justify-self:start; line-height:0; }
  .wordmark :global(img) { display:block; width:auto; height:76px; transition:height 0.25s ease; }
  .site-header.is-scrolled .wordmark :global(img) { height:56px; }
  nav { display:flex; justify-self:center; gap:32px; }
  nav a { position:relative; color:var(--color-ink); text-decoration:none; }
  nav a::after { position:absolute; right:0; bottom:-8px; left:0; height:1px; background:currentColor; content:""; transform:scaleX(0); transform-origin:left; transition:transform .2s ease; }
  nav a:hover::after, nav a[aria-current="page"]::after { transform:scaleX(1); }
  .header-cta { justify-self:end; display:inline-flex; align-items:center; gap:8px; padding:12px 16px; background:var(--color-ink); color:var(--color-paper); font-size:0.9rem; font-weight:600; text-decoration:none; transition:background .2s ease, transform .2s ease; }
  .header-cta:hover { background:var(--color-teal); transform:translateY(-1px); }
  .nav-mobile-contact { display:none; }
  .menu-toggle { display:none; }
  /* tablettes tactiles : agrandir la zone cliquable des liens sans bouger la mise en page */
  @media (pointer:coarse) and (min-width:761px) { nav a { padding:12px 0; } }
  @media(max-width:760px) {
    .site-header { backdrop-filter:none; background:var(--color-paper); }
    .header-inner { position:relative; display:flex; justify-content:space-between; padding-top:16px; padding-bottom:16px; }
    .site-header.is-scrolled .header-inner { padding-top:11px; padding-bottom:11px; }
    .wordmark, .menu-toggle { position:relative; z-index:12; }
    .wordmark :global(img) { height:58px; }
    .site-header.is-scrolled .wordmark :global(img) { height:48px; }
    .header-cta { display:none; }
    .menu-toggle { display:grid; width:44px; height:44px; place-content:center; gap:7px; border:0; background:transparent; color:var(--color-ink); cursor:pointer; }
    .menu-toggle span { display:block; width:24px; height:1.5px; background:currentColor; transition:transform .2s ease; }
    .menu-open .menu-toggle span:first-child { transform:translateY(4px) rotate(45deg); }
    .menu-open .menu-toggle span:last-child { transform:translateY(-4px) rotate(-45deg); }
    nav { position:absolute; top:100%; left:0; right:0; display:none; flex-direction:column; gap:0; padding:8px var(--gutter) 24px; background:var(--color-paper); border-top:1px solid var(--color-paper-dim); }
    nav a { padding:15px 0; font-size:18px; }
    nav a::after { display:none; }
    .nav-mobile-contact { display:block; margin-top:10px; padding:13px 16px; background:var(--color-ink); color:var(--color-paper); }
    .menu-open nav {
      position:fixed;
      inset:0;
      justify-self:stretch;
      width:100%;
      height:100dvh;
      box-sizing:border-box;
      align-items:stretch;
      overflow-y:auto;
      z-index:11;
      display:flex;
      padding-top:calc(112px + env(safe-area-inset-top));
      padding-right:max(24px, env(safe-area-inset-right));
      padding-bottom:36px;
      padding-left:max(24px, env(safe-area-inset-left));
      background:var(--color-paper);
      border:0;
    }
    .menu-open nav a { flex-shrink:0; padding:18px 0; }
    .menu-open nav .nav-mobile-contact {
      align-self:flex-start;
      width:auto;
      margin-top:24px;
      padding:14px 22px;
      color:var(--color-paper);
    }
  }
</style>
