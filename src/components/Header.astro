---
import { rel } from "../lib/base";
import { Image } from "astro:assets";
import wordmark from "../assets/logo-wordmark-v1.png";

const path = Astro.url.pathname.replace(/\/$/, "");
const isHome = path === rel("/").replace(/\/$/, "");
const links = [
  { href: "/produits", label: "Produits" },
  { href: "/actualites", label: "Actualités" },
];
const isActive = (href: string) => {
  const target = rel(href).replace(/\/$/, "");
  return href === "/" ? path === target : path.startsWith(target);
};
---

<div class:list={["header-outer", { "is-home": isHome }]}>
  <header class="wrap">
    <a class="brand" href={rel("/")} aria-label="Nice Emballage — accueil">
      <Image src={wordmark} alt="Nice Emballage" />
    </a>
    <nav aria-label="Navigation principale">
      <ul>
        {
          links.map((link) => (
            <li>
              <a
                href={rel(link.href)}
                aria-current={isActive(link.href) ? "page" : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <a class="contact-link" href={rel("/contact")}>Nous contacter</a>
    <details class="mobile-menu">
      <summary aria-label="Ouvrir le menu"
        ><span aria-hidden="true"></span></summary
      >
      <nav aria-label="Navigation mobile">
        <ul>
          {
            links.map((link) => (
              <li>
                <a
                  href={rel(link.href)}
                  aria-current={isActive(link.href) ? "page" : undefined}
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
        <a class="mobile-menu__contact" href={rel("/contact")}>Nous contacter</a
        >
        <span class="mobile-menu__legal">© 2026 Nice Emballage</span>
      </nav>
    </details>
  </header>
</div>

<style>
  .header-outer {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(245, 244, 240, 0.94);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
  }
  .header-outer.is-home {
    position:fixed;
    right:0;
    left:0;
    background:rgba(245,244,240,.82);
  }
  header {
    display: flex;
    align-items: center;
    min-height: 94px;
  }
  .brand {
    justify-self: start;
    display: block;
    line-height: 0;
  }
  .brand :global(img) {
    display: block;
    width: auto;
    height: 64px;
  }
  nav {
    display: flex;
    align-items: center;
    margin-left: auto;
  }
  ul {
    display: flex;
    align-items: center;
    gap: clamp(22px, 3vw, 46px);
    list-style: none;
  }
  a {
    display: inline-block;
    padding: 8px 0;
    color: var(--color-ink);
    font-size: 13px;
    font-weight: 700;
    text-decoration: none;
  }
  a[aria-current="page"] {
    font-weight: 800;
  }
  a:hover {
    color: var(--color-text-soft);
  }
  .contact-link {
    margin-left: 28px;
    padding: 13px 19px;
    border-radius: var(--radius-pill);
    background: var(--color-yellow);
    color: var(--color-ink);
    font-size: 13px;
    white-space: nowrap;
  }
  .contact-link:hover {
    background: var(--color-yellow-hover);
    color: var(--color-ink);
  }
  .mobile-menu {
    display: none;
  }

  @media (max-width: 720px) {
    .header-outer {
      padding-top: env(safe-area-inset-top);
    }
    header {
      position: relative;
      z-index: 2;
      min-height: 76px;
      justify-content: space-between;
    }
    .brand { position:relative; z-index:2; }
    .brand :global(img) {
      height: 46px;
    }
    header > nav,
    .contact-link {
      display: none;
    }
    .mobile-menu {
      display: block;
    }
    .mobile-menu summary {
      position:relative;
      z-index:2;
      display: flex;
      align-items: center;
      justify-content: center;
      width: 44px;
      height: 44px;
      padding: 0;
      border-radius: 50%;
      background: var(--color-yellow);
      color: var(--color-ink);
      cursor: pointer;
      list-style: none;
    }
    .mobile-menu summary::-webkit-details-marker {
      display: none;
    }
    .mobile-menu summary span,
    .mobile-menu summary span::before,
    .mobile-menu summary span::after {
      display: block;
      width: 17px;
      height: 1.5px;
      background: currentColor;
      transition:
        transform 0.2s ease,
        opacity 0.2s ease;
      content: "";
    }
    .mobile-menu summary span {
      position: relative;
    }
    .mobile-menu summary span::before,
    .mobile-menu summary span::after {
      position: absolute;
      left: 0;
    }
    .mobile-menu summary span::before {
      top: -6px;
    }
    .mobile-menu summary span::after {
      top: 6px;
    }
    .mobile-menu[open] summary span {
      transform: rotate(45deg);
    }
    .mobile-menu[open] summary span::before {
      top: 0;
      transform: rotate(90deg);
    }
    .mobile-menu[open] summary span::after {
      opacity: 0;
    }
    .mobile-menu > nav {
      position: fixed;
      z-index: 1;
      inset: 0;
      display: flex;
      flex-direction: column;
      min-height: 100vh;
      min-height: 100svh;
      margin: 0;
      padding: calc(76px + env(safe-area-inset-top) + 64px) max(20px, calc((100vw - var(--container)) / 2)) calc(22px + env(safe-area-inset-bottom));
      background: var(--color-paper);
      background-image: linear-gradient(90deg, rgba(240,180,41,.14) 1px, transparent 1px), linear-gradient(rgba(240,180,41,.14) 1px, transparent 1px);
      background-size: 25px 25px;
      box-shadow: none;
    }
    .mobile-menu ul {
      display: grid;
      gap: 14px;
      margin: 0;
    }
    .mobile-menu nav a {
      display: block;
      padding: 6px 0;
      font-size: clamp(40px, 10vw, 54px);
      font-weight: 800;
      letter-spacing: -0.065em;
      line-height: .95;
    }
    .mobile-menu__contact {
      width: 100%;
      margin-top: auto;
      padding: 18px !important;
      border-radius: var(--radius-pill);
      background: var(--color-yellow);
      text-align: center;
      font-size: 16px !important;
      letter-spacing: -0.025em !important;
      line-height: 1 !important;
    }
    .mobile-menu__legal {
      display:block;
      margin-top:24px;
      color:var(--color-text-soft);
      font-size:11px;
      font-weight:700;
      letter-spacing:.08em;
      text-align:center;
      text-transform:uppercase;
    }
    :global(body:has(.mobile-menu[open])) { overflow:hidden; }
  }

  @media (max-width: 520px) {
    header {
      min-height: 68px;
    }
    .wrap {
      padding-right: 20px;
      padding-left: 20px;
    }
    .brand :global(img) {
      height: 40px;
    }
  }
</style>
