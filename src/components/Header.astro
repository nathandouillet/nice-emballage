---
import Logo from "./Logo.astro";
import { rel } from "../lib/base";

const path = Astro.url.pathname.replace(/\/$/, "");
const links = [
  { href: "/", label: "Accueil" },
  { href: "/actualites", label: "Actualités" },
  { href: "/contact", label: "Contact" },
];
const isActive = (href: string) => {
  const target = rel(href).replace(/\/$/, "");
  return href === "/" ? path === target : path.startsWith(target);
};
---
<div class="header-outer">
  <header>
    <a href={rel("/")} class="logo-link" aria-label="Nice Emballage — accueil">
      <Logo />
    </a>
    <div class="nav-right">
      <nav>
        <ul>
          {
            links.map((link) => (
              <li>
                <a
                  href={rel(link.href)}
                  aria-current={isActive(link.href) ? "page" : undefined}
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <a href={rel("/contact")} class="nav-cta">Nous contacter</a>
    </div>
  </header>
</div>

<style>
  .header-outer {
    position: sticky;
    top: 20px;
    z-index: 50;
    padding: 20px var(--gutter) 0;
  }
  header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: var(--container);
    margin: 0 auto;
    padding: 12px 24px;
    background: rgba(245, 244, 240, 0.7);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 1px solid rgba(220, 217, 209, 0.6);
    border-radius: var(--radius-pill);
    box-shadow: var(--shadow-float);
  }
  .logo-link {
    text-decoration: none;
    color: inherit;
  }
  .nav-right {
    display: flex;
    align-items: center;
    gap: 24px;
  }
  nav ul {
    display: flex;
    gap: 32px;
    list-style: none;
    font-size: 13.5px;
    font-weight: 500;
  }
  nav a {
    color: var(--color-ink);
    text-decoration: none;
  }
  nav a[aria-current="page"] {
    color: var(--color-teal);
    font-weight: 700;
  }

  @media (max-width: 720px) {
    nav ul {
      gap: 18px;
    }
    .nav-right {
      gap: 14px;
    }
    .nav-cta {
      display: none;
    }
  }
</style>
