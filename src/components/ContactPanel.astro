---
import WhatsAppButton from "./WhatsAppButton.astro";
import MapEmbed from "./MapEmbed.astro";

interface Props {
  title?: string;
  lead?: string;
  /** Affiche la carte Google Maps sous le formulaire. */
  showMap?: boolean;
  /** "dark" = bande sombre (ancre de la home) · "light" = fond clair (page /contact). */
  tone?: "dark" | "light";
}
const {
  title = "Parlons de votre projet",
  lead = "Un email, un coup de fil ou un message WhatsApp — on répond vite.",
  showMap = true,
  tone = "dark",
} = Astro.props;

const email = "infos@nice-emballage.com";
const phone = "+226 64 98 66 66";
const phoneHref = "tel:+22664986666";
const address = "Borgho, sur la route de Fada";
const coords = "12.411808,-1.418128";
const directions = `https://www.google.com/maps/dir/?api=1&destination=${coords}`;
---
<section class:list={["contact-section", { "is-light": tone === "light" }]}>
  <div class="wrap">
    <div class="cu">
      <div class="cu-head">
        <h3>{title}</h3>
        <p class="cu-lead">{lead}</p>
        <div class="cu-direct">
          <a href={phoneHref}>{phone}</a>
          <a href={`mailto:${email}`}>{email}</a>
          <WhatsAppButton />
        </div>
      </div>

      <form class="contact-form" data-mailto={email}>
        <div class="cu-row">
          <label>
            <span>Nom</span>
            <input type="text" name="nom" autocomplete="name" required />
          </label>
          <label>
            <span>Entreprise</span>
            <input type="text" name="entreprise" autocomplete="organization" />
          </label>
        </div>
        <label>
          <span>Email</span>
          <input type="email" name="email" autocomplete="email" required />
        </label>
        <label>
          <span>Message</span>
          <textarea name="message" rows="3" required></textarea>
        </label>
        <button type="submit" class="btn-primary">Envoyer le message</button>
      </form>
    </div>

    {
      showMap && (
        <div class="contact-find">
          <div class="contact-find__info">
            <span class="contact-find__kicker">Nous trouver</span>
            <p class="contact-find__addr">
              {address}
              <br />
              Ouagadougou, Burkina Faso
            </p>
            <p class="contact-find__meta">Ouvert tous les jours · 7h30 – 18h00</p>
            <a
              class="contact-find__dir"
              href={directions}
              target="_blank"
              rel="noopener"
            >
              Itinéraire
            </a>
          </div>
          <div class="contact-find__map">
            <MapEmbed coords={coords} />
          </div>
        </div>
      )
    }
  </div>
</section>

<script>
  document.querySelectorAll<HTMLFormElement>("form.contact-form").forEach((form) => {
    form.addEventListener("submit", (event) => {
      event.preventDefault();
      const to = form.dataset.mailto ?? "";
      const data = new FormData(form);
      const nom = String(data.get("nom") ?? "").trim();
      const entreprise = String(data.get("entreprise") ?? "").trim();
      const from = String(data.get("email") ?? "").trim();
      const message = String(data.get("message") ?? "").trim();

      const subject = `Demande de ${nom}${entreprise ? ` — ${entreprise}` : ""}`;
      const body = [
        `Nom : ${nom}`,
        entreprise ? `Entreprise : ${entreprise}` : null,
        `Email : ${from}`,
        "",
        message,
      ]
        .filter((line) => line !== null)
        .join("\n");

      window.location.href = `mailto:${to}?subject=${encodeURIComponent(
        subject,
      )}&body=${encodeURIComponent(body)}`;
    });
  });
</script>

<style>
  /* Bande sombre — l'ancre visuelle de la home.
     Les couleurs "thémables" passent par des variables, surchargées en .is-light. */
  .contact-section {
    --cs-bg: var(--color-ink);
    --cs-fg: var(--color-paper);
    --cs-lead: var(--color-on-ink);
    --cs-label: var(--color-on-ink-faint);
    --cs-rule: rgba(245, 244, 240, 0.22);
    --cs-accent: var(--color-yellow);
    --cs-link-hover: var(--color-yellow);
    --cs-find-border: transparent;

    padding: 88px 0;
    background: var(--cs-bg);
    color: var(--cs-fg);
  }
  .contact-section.is-light {
    --cs-bg: transparent;
    --cs-fg: var(--color-ink);
    --cs-lead: var(--color-text-muted);
    --cs-label: var(--color-text-faint);
    --cs-rule: var(--color-stone);
    --cs-accent: var(--color-ink);
    --cs-link-hover: var(--color-text-soft);
    --cs-find-border: transparent;

    padding-top:104px;
    padding-bottom:120px;
  }

  .cu {
    display: grid;
    grid-template-columns: .82fr 1.18fr;
    gap: clamp(48px,8vw,120px);
    align-items: start;
  }

  .cu-head h3 {
    max-width: 11ch;
    font-family: var(--font-display);
    font-size:clamp(3.3rem,6.3vw,6.5rem);
    font-weight: 800;
    letter-spacing:-.075em;
    line-height:.9;
  }
  .cu-lead {
    margin-top:28px;
    max-width:31ch;
    font-size:clamp(1.05rem,1.5vw,1.25rem);
    line-height:1.45;
    color: var(--cs-lead);
  }
  .cu-direct {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap:10px;
    margin-top:36px;
    font-size:clamp(1rem,1.5vw,1.18rem);
    font-weight:700;
  }
  .cu-direct a {
    color: var(--cs-fg);
    text-decoration: none;
  }
  .cu-direct a:hover {
    color: var(--cs-link-hover);
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap:24px;
    padding:clamp(28px,4vw,48px);
    border-radius:22px;
    background:var(--color-paper-dim);
  }
  .cu-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap:20px;
  }
  .contact-form label {
    display: flex;
    flex-direction: column;
    gap:10px;
  }
  .contact-form label span {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--cs-label);
  }
  .contact-form input,
  .contact-form textarea {
    border: 0;
    border:0;
    border-radius:0;
    border-bottom:1.5px solid var(--cs-rule);
    background:transparent;
    padding:10px 2px;
    font-family: inherit;
    font-size: 16px;
    color: var(--cs-fg);
    caret-color: var(--cs-accent);
    transition: border-color 0.2s ease;
  }
  .contact-form textarea {
    resize: vertical;
    min-height:80px;
  }
  .contact-form input:focus,
  .contact-form textarea:focus {
    outline: none;
    border-bottom-color: var(--cs-accent);
  }
  .contact-form .btn-primary {
    align-self: flex-start;
    margin-top:6px;
  }

  /* --- Module "Nous trouver" : carte intégrée à la prise de contact --- */
  .contact-find {
    display: grid;
    grid-template-columns:minmax(280px,.72fr) 1.28fr;
    min-height:440px;
    margin-top:112px;
    color: var(--color-ink);
    border:0;
    border-radius:22px;
    overflow: hidden;
  }
  .contact-find__info {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap:12px;
    padding:clamp(32px,4vw,54px);
    background: var(--color-paper-dim);
  }
  .contact-find__kicker {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color:var(--color-ink);
  }
  .contact-find__addr {
    font-size:clamp(1.2rem,2vw,1.55rem);
    font-weight:800;
    letter-spacing:-.035em;
    line-height:1.2;
  }
  .contact-find__meta {
    font-size: 14px;
    color: var(--color-text-muted);
  }
  .contact-find__dir {
    margin-top: 8px;
    padding:13px 20px;
    border-radius:var(--radius-pill);
    background: var(--color-yellow);
    color: var(--color-ink);
    font-size:14px;
    font-weight:800;
    text-decoration: none;
    transition: background 0.2s ease;
  }
  .contact-find__dir:hover {
    background: var(--color-yellow-hover);
  }
  .contact-find__map {
    position: relative;
    min-height:440px;
    background: var(--color-stone);
  }
  .contact-find__map :global(#map),
  .contact-find__map :global(#map iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    min-height: 0;
  }

  @media (max-width: 860px) {
    .contact-section.is-light { padding-top:74px; padding-bottom:76px; }
    .cu {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .contact-find {
      grid-template-columns: 1fr;
      min-height: 0;
      margin-top:76px;
    }
    .contact-find__info {
      justify-content: flex-start;
    }
    .contact-find__map { min-height:340px; }
  }
  @media (max-width: 480px) {
    .cu-row {
      grid-template-columns: 1fr;
    }
  }
</style>
