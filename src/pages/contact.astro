---
import Layout from "../layouts/Layout.astro";
import SectionHead from "../components/SectionHead.astro";
import ContactPanel from "../components/ContactPanel.astro";
---
<Layout
  title="Contact — Nice Emballage"
  description="Contactez Nice Emballage : téléphone, WhatsApp ou email. Devis rapide pour vos emballages plastique et vos lignes de production."
>
  <SectionHead kicker="CONTACT" title="Parlons de votre projet" />
  <ContactPanel
    tone="light"
    title="Écrivez-nous"
    lead="Réponse rapide, du lundi au dimanche — téléphone, WhatsApp ou email."
  />
</Layout>
