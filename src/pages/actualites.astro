---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import ArticleCard from "../components/ArticleCard.astro";
import { rel } from "../lib/base";

const articles = (
  await getCollection("articles", ({ data }) => !data.draft)
).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const [featured, ...remainingArticles] = articles;
const formatDate = (date: Date) =>
  new Intl.DateTimeFormat("fr-FR", {
    day: "numeric",
    month: "long",
    year: "numeric",
  }).format(date);
---

<Layout
  title="Actualités — Nice Emballage"
  description="Les dernières nouvelles de Nice Emballage, fabricant d'emballage plastique et de machines industrielles au Burkina Faso."
>
  <main class="news-page">
    <section class="news-intro" aria-labelledby="news-title">
      <div class="wrap">
        <h1 id="news-title">Les nouvelles de Nice Emballage.</h1>
        <p>La vie de nos ateliers, de nos équipes et de nos projets à Ouagadougou.</p>
      </div>
    </section>

    {
      featured && (
        <section class="featured-story wrap" aria-label="À la une">
          <a href={rel(`/actualites/${featured.id}`)}>
            <div class="featured-story__image">
              <Image src={featured.data.cover} alt={featured.data.title} widths={[600, 900, 1200]} sizes="(max-width: 800px) 100vw, 54vw" />
            </div>
            <div class="featured-story__copy">
              <time datetime={featured.data.date.toISOString()}>{formatDate(featured.data.date)}</time>
              <h2>{featured.data.title}</h2>
              <p>{featured.data.excerpt}</p>
              <span>Lire l’article</span>
            </div>
          </a>
        </section>
      )
    }

    <section class="articles-list wrap" aria-label="Toutes les actualités">
      {remainingArticles.map((article) => <ArticleCard article={article} />)}
    </section>
  </main>
</Layout>

<style>
  .news-page { overflow:hidden; background:var(--color-paper); }
  .news-intro { padding:104px 0 84px; text-align:center; }
  .news-intro h1 { max-width:13ch; margin:0 auto; font-family:var(--font-display); font-size: var(--text-h1); font-weight: var(--fw-display); letter-spacing: var(--ls-display-xl); line-height: var(--lh-display-xl); }
  .news-intro p { max-width:39ch; margin:28px auto 0; color:var(--color-text-soft); font-size: var(--text-lead); line-height:1.45; }

  .featured-story { padding-bottom:112px; }
  .featured-story > a { display:grid; grid-template-columns:1.08fr .92fr; align-items:center; gap:clamp(2.5rem,7vw,9rem); color:var(--color-ink); text-decoration:none; }
  .featured-story__image { aspect-ratio:1; overflow:hidden; border-radius: var(--radius-media); background:var(--color-stone); }
  .featured-story__image :global(img) { display:block; width:100%; height:100%; object-fit:cover; }
  .featured-story__copy { padding-right:clamp(0rem,3vw,3rem); }
  .featured-story time { color:var(--color-text-faint); font-size: 13px; font-weight:700; }
  .featured-story h2 { max-width:12ch; margin:18px 0 0; font-family:var(--font-display); font-size: var(--text-h2-sm); font-weight: var(--fw-display); letter-spacing: var(--ls-display-xl); line-height:.92; }
  .featured-story p { max-width:35ch; margin:24px 0 0; color:var(--color-text-soft); font-size: var(--text-lead); line-height:1.5; }
  .featured-story span { display:inline-block; margin-top:30px; padding: 15px 26px; border-radius:var(--radius-pill); background:var(--color-yellow); font-size: 15px; font-weight: 700; }
  .featured-story > a:hover span { background:var(--color-yellow-hover); }

  .articles-list { display:grid; grid-template-columns:repeat(3,1fr); gap:64px 28px; padding-bottom:120px; }
  @media (max-width:900px) { .articles-list { grid-template-columns:repeat(2,1fr); } }
  @media (max-width:800px) { .news-intro { padding:74px 0 62px; } .featured-story { padding-bottom:76px; } .featured-story > a { grid-template-columns:1fr; gap:30px; } .featured-story__copy { padding-right:0; } }
  @media (max-width:560px) { .articles-list { grid-template-columns:1fr; gap:44px; padding-bottom:76px; } }
</style>
