---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import SectionHead from "../components/SectionHead.astro";
import ArticleCard from "../components/ArticleCard.astro";

const articles = (
  await getCollection("articles", ({ data }) => !data.draft)
).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---
<Layout
  title="Actualités — Nice Emballage"
  description="Les dernières nouvelles de Nice Emballage, fabricant d'emballage plastique et de machines industrielles au Burkina Faso."
>
  <SectionHead kicker="ACTUALITÉS" title="Toutes nos actualités" />

  <div class="articles-grid wrap">
    {articles.map((article) => <ArticleCard article={article} />)}
  </div>
</Layout>

<style>
  .articles-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 44px 28px;
    margin-bottom: 96px;
  }

  @media (max-width: 900px) {
    .articles-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 560px) {
    .articles-grid {
      grid-template-columns: 1fr;
      gap: 36px;
    }
  }
</style>
