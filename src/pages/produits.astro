<script>
  document.querySelectorAll("[data-bottle-carousel]").forEach((carousel) => {
    const track = carousel.querySelector("[data-carousel-viewport]");
    const previous = carousel.querySelector("[data-carousel-previous]");
    const next = carousel.querySelector("[data-carousel-next]");

    const move = (direction) => {
      const card = track.querySelector(".bottle-range__card");
      if (!card) return;
      const gap =
        Number.parseFloat(
          getComputedStyle(track.querySelector(".bottle-range__track")).gap,
        ) || 0;
      track.scrollBy({
        left: direction * (card.getBoundingClientRect().width + gap),
        behavior: "smooth",
      });
    };

    previous?.addEventListener("click", () => move(-1));
    next?.addEventListener("click", () => move(1));
  });

  let openBottleModelDialog = null;

  const closeBottleModels = () => {
    if (!openBottleModelDialog) return;
    openBottleModelDialog.hidden = true;
    openBottleModelDialog = null;
    document.body.style.overflow = "";
  };

  document.querySelectorAll("[data-bottle-model-trigger]").forEach((trigger) => {
    trigger.addEventListener("click", () => {
      const dialog = document.getElementById(trigger.dataset.bottleModelTrigger);
      if (!dialog) return;
      openBottleModelDialog = dialog;
      dialog.hidden = false;
      document.body.style.overflow = "hidden";
      dialog.querySelector("[data-bottle-model-close]")?.focus();
    });
  });

  document.querySelectorAll("[data-bottle-model-dialog]").forEach((dialog) => {
    dialog.querySelector("[data-bottle-model-close]")?.addEventListener("click", closeBottleModels);
    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) closeBottleModels();
    });
  });
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && openBottleModelDialog) {
      closeBottleModels();
    }
  });
</script>
