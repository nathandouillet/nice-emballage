---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import preformes from "../assets/preformes-reelles-sombre.png";
import bouchons from "../assets/bouchons-pyramide-sombre.png";
import bouteilles from "../assets/bouteilles-reelles-sombre.png";
import emballages from "../assets/film-emballage-sombre.png";
import machineMoule from "../assets/machine-atelier-unifiee.png";
import machineFilm from "../assets/machine-film-unifiee-v2.png";
import machineLigne from "../assets/machine-ligne-unifiee.png";
import machineSceller from "../assets/machine-sceller-unifiee.png";

const products = [
  { image: preformes, name: "Préformes", text: "Des préformes pour vos projets de soufflage et de conditionnement." },
  { image: bouchons, name: "Bouchons", text: "Des bouchons pour compléter vos contenants et vos formats." },
  { image: bouteilles, name: "Bouteilles", text: "Des bouteilles adaptées à vos boissons et produits liquides." },
  { image: emballages, name: "Films d’emballage", text: "Des solutions de film plastique pour protéger et conditionner vos produits." },
];

const machines = [
  { image: machineMoule, name: "Moule d’injection" },
  { image: machineFilm, name: "Ligne de film plastique" },
  { image: machineLigne, name: "Ligne de conditionnement" },
  { image: machineSceller, name: "Machine à sceller" },
];
---

<Layout
  title="Produits — Nice Emballage"
  description="Découvrez les produits Nice Emballage : préformes, bouchons, bouteilles, films d’emballage et équipements."
>
  <main class="catalogue">
    <header class="catalogue-intro">
      <div class="wrap">
        <h1>Produits.</h1>
        <p>Des emballages fabriqués à Ouagadougou et des équipements pour accompagner votre production.</p>
      </div>
    </header>

    <section class="catalogue-section wrap" aria-labelledby="products-title">
      <header class="catalogue-section__head">
        <h2 id="products-title">Ce que nous fabriquons.</h2>
        <p>Des produits pensés pour vos besoins de conditionnement.</p>
      </header>
      <div class="catalogue-grid">
        {
          products.map((product) => (
            <article class="catalogue-card">
              <div class="catalogue-card__image">
                <Image src={product.image} alt={product.name} widths={[480, 720, 1000]} sizes="(max-width: 700px) 100vw, 50vw" />
              </div>
              <h3>{product.name}</h3>
              <p>{product.text}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="machine-catalogue wrap" aria-labelledby="machines-title">
      <header class="catalogue-section__head">
        <h2 id="machines-title">Machines & équipements.</h2>
        <p>Une sélection d’équipements pour accompagner votre production.</p>
      </header>
      <div class="machine-catalogue__grid">
        {
          machines.map((machine) => (
            <article class="machine-catalogue__card">
              <div>
                <Image src={machine.image} alt={machine.name} widths={[480, 720, 1000]} sizes="(max-width: 700px) 100vw, 25vw" />
              </div>
              <h3>{machine.name}</h3>
            </article>
          ))
        }
      </div>
    </section>

  </main>
</Layout>

<style>
  .catalogue { overflow:hidden; background:var(--color-paper); }
  .catalogue-intro { position:relative; isolation:isolate; padding:84px 0 72px; }
  .catalogue-intro::before { position:absolute; z-index:-1; top:54px; left:-158px; width:276px; height:322px; border:29px solid var(--color-yellow); border-bottom:0; border-radius:175px 175px 0 0; content:""; }
  .catalogue-intro h1 { max-width:8ch; margin:0; font-family:var(--font-display); font-size:clamp(4rem,8vw,8.8rem); font-weight:800; letter-spacing:-.085em; line-height:.8; }
  .catalogue-intro p { max-width:35ch; margin:30px 0 0; color:var(--color-text-soft); font-size:clamp(1.06rem,1.6vw,1.3rem); line-height:1.45; }

  .catalogue-section, .machine-catalogue { padding-bottom:84px; }
  .catalogue-section__head { display:grid; grid-template-columns:1fr minmax(210px, .45fr); align-items:end; gap:30px; margin-bottom:52px; }
  .catalogue-section__head h2 { max-width:13ch; margin:0; font-family:var(--font-display); font-size:clamp(2.7rem,5.1vw,5.8rem); font-weight:800; letter-spacing:-.075em; line-height:.88; }
  .catalogue-section__head p { max-width:28ch; margin:0; color:var(--color-text-soft); font-size:1.05rem; line-height:1.45; }
  .catalogue-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:22px; }
  .catalogue-card__image { aspect-ratio:1; overflow:hidden; border-radius:22px; background:var(--color-stone); }
  .catalogue-card__image :global(img) { display:block; width:100%; height:100%; object-fit:cover; }
  .catalogue-card h3 { margin:16px 4px 0; font-family:var(--font-display); font-size:clamp(1.6rem,2.2vw,2.3rem); font-weight:800; letter-spacing:-.065em; line-height:.92; }
  .catalogue-card p { max-width:34ch; margin:9px 4px 0; color:var(--color-text-soft); font-size:.94rem; line-height:1.4; }

  .machine-catalogue__grid { display:grid; grid-template-columns:repeat(4,1fr); gap:22px; }
  .machine-catalogue__card > div { aspect-ratio:4/3; overflow:hidden; border-radius:22px; background:var(--color-stone); }
  .machine-catalogue__card :global(img) { display:block; width:100%; height:100%; object-fit:cover; }
  .machine-catalogue__card h3 { margin:15px 4px 0; font-family:var(--font-display); font-size:clamp(1.35rem,1.8vw,1.85rem); font-weight:800; letter-spacing:-.055em; line-height:.98; }

  @media (max-width:800px) {
    .catalogue-intro { padding:74px 0 72px; }
    .catalogue-intro::before { top:35px; left:-204px; opacity:.75; }
    .catalogue-section, .machine-catalogue { padding-bottom:64px; }
    .catalogue-section__head { grid-template-columns:1fr; gap:22px; margin-bottom:38px; }
    .catalogue-grid, .machine-catalogue__grid { grid-template-columns:repeat(2,1fr); }
    .catalogue-grid { gap:38px 16px; }
    .machine-catalogue__grid { gap:28px 16px; }
  }
  @media (max-width:640px) { .catalogue-grid, .machine-catalogue__grid { grid-template-columns:none; grid-auto-flow:column; grid-auto-columns:minmax(76vw, 300px); width:100vw; margin-right:0; margin-left:calc(50% - 50vw); padding:0 var(--gutter); overflow-x:auto; overscroll-behavior-x:contain; scroll-padding-inline:var(--gutter); scroll-snap-type:x mandatory; scrollbar-width:none; }.catalogue-grid::-webkit-scrollbar, .machine-catalogue__grid::-webkit-scrollbar { display:none; }.catalogue-card, .machine-catalogue__card { scroll-snap-align:start; } }
</style>
