---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import filmsStudio from "../assets/films-emballage-studio-v1.png";
import capsStudio from "../assets/bouchons-studio-couleurs-v2.png";
import preformsStudio from "../assets/preformes-macro-editorial-v1.png";
import bouteilles250ml from "../assets/bouteille-250ml-studio-v2.png";
import bouteilles250mlModele2 from "../assets/bouteille-250ml-modele-2-studio-v1.png";
import bouteilles250mlModele3 from "../assets/bouteille-250ml-modele-3-studio-v1.png";
import bouteilles300ml from "../assets/bouteille-300ml-studio-v2.png";
import bouteilles300mlModele2 from "../assets/bouteille-300ml-modele-2-studio-v1.png";
import bouteilles330ml from "../assets/bouteille-330ml-studio-v3.png";
import bouteilles500ml from "../assets/bouteille-500ml-studio-v3.png";
import bouteilles500mlModele2 from "../assets/bouteille-500ml-modele-2-studio-v1.png";
import bouteilles500mlModele3 from "../assets/bouteille-500ml-modele-3-studio-v1.png";
import bouteilles500mlModele4 from "../assets/bouteille-500ml-modele-4-studio-v1.png";
import bouteilles500mlModele5 from "../assets/bouteille-500ml-modele-5-studio-v1.png";
import bouteilles1l from "../assets/bouteille-1l-studio-v2.png";
import bouteilles1lModele1 from "../assets/bouteille-1l-modele-1-studio-v1.png";
import bouteilles1lModele2 from "../assets/bouteille-1l-modele-2-studio-v1.png";
import bouteilles15l from "../assets/bouteille-15l-studio-v2.png";
import bouteilles15lModele1 from "../assets/bouteille-15l-modele-1-studio-v1.png";
import bouteilles15lModele2 from "../assets/bouteille-15l-modele-2-studio-v1.png";
import { rel } from "../lib/base";

const bottleFormats = [
  {
    image: bouteilles250ml,
    size: "250 ml",
    className: "format-250",
    modelDialog: "bottle-250ml-model-dialog",
  },
  {
    image: bouteilles300ml,
    size: "300 ml",
    className: "format-300",
    modelDialog: "bottle-300ml-model-dialog",
  },
  {
    image: bouteilles330ml,
    size: "330 ml",
    className: "format-330",
    modelDialog: "bottle-330ml-model-dialog",
  },
  {
    image: bouteilles500ml,
    size: "500 ml",
    className: "format-500",
    modelDialog: "bottle-500ml-model-dialog",
  },
  {
    image: bouteilles1l,
    size: "1 L",
    className: "format-1l",
    modelDialog: "bottle-1l-model-dialog",
  },
  {
    image: bouteilles15l,
    size: "1,5 L",
    className: "format-15l",
    modelDialog: "bottle-15l-model-dialog",
  },
];
---

<Layout
  title="Produits — Nice Emballage"
  description="Découvrez les produits Nice Emballage : préformes, bouchons, bouteilles, films d’emballage et équipements."
>
  <main class="catalogue">
    <header class="catalogue-intro">
      <div class="wrap">
        <h1>Produits</h1>
        <p>
          Des emballages fabriqués à Ouagadougou et des équipements pour
          accompagner votre production.
        </p>
      </div>
    </header>

    <section class="bottle-range wrap" aria-labelledby="bottle-range-title">
      <header class="bottle-range__head">
        <p class="bottle-range__eyebrow">Bouteilles PET</p>
        <h2 id="bottle-range-title">Une forme pour chaque format</h2>
        <p class="bottle-range__intro">
          De 250 ml à 1,5 L, des formats pensés pour s’adapter à votre produit.
        </p>
      </header>
      <div class="bottle-range__carousel" data-bottle-carousel>
        <button
          class="bottle-range__control"
          type="button"
          aria-label="Voir les formats précédents"
          data-carousel-previous
        >
          <span aria-hidden="true">‹</span>
        </button>
        <div class="bottle-range__viewport" data-carousel-viewport>
          <div class="bottle-range__track">
            {
              bottleFormats.map((bottle) => (
                <article class={`bottle-range__card ${bottle.className}`}>
                  {bottle.modelDialog ? (
                    <button
                      class="bottle-range__model-trigger"
                      type="button"
                      data-bottle-model-trigger={bottle.modelDialog}
                      aria-haspopup="dialog"
                      aria-controls={bottle.modelDialog}
                    >
                      <div>
                        <Image
                          src={bottle.image}
                          alt={`Bouteille PET ${bottle.size}`}
                          widths={[480, 720, 1000]}
                          sizes="(max-width: 700px) 76vw, 33vw"
                        />
                      </div>
                      <h3>{bottle.size}</h3>
                      <span>Voir les modèles</span>
                    </button>
                  ) : (
                    <>
                      <div>
                        <Image
                          src={bottle.image}
                          alt={`Bouteille PET ${bottle.size}`}
                          widths={[480, 720, 1000]}
                          sizes="(max-width: 700px) 76vw, 33vw"
                        />
                      </div>
                      <h3>{bottle.size}</h3>
                    </>
                  )}
                </article>
              ))
            }
          </div>
        </div>
        <button
          class="bottle-range__control"
          type="button"
          aria-label="Voir les formats suivants"
          data-carousel-next
        >
          <span aria-hidden="true">›</span>
        </button>
      </div>
      <p class="bottle-range__note">
        D’autres modèles sont disponibles. <a class="cta-link" href={rel("/contact")}
          >Contactez-nous</a
        > pour découvrir l’ensemble de la gamme.
      </p>
    </section>

    <div
      class="bottle-model-dialog"
      id="bottle-15l-model-dialog"
      data-bottle-model-dialog
      role="dialog"
      aria-modal="true"
      aria-labelledby="bottle-15l-model-dialog-title"
      hidden
    >
      <div class="bottle-model-dialog__inner">
        <div class="bottle-model-dialog__head">
          <div>
            <p>1,5 L</p>
            <h2 id="bottle-15l-model-dialog-title">Les trois modèles</h2>
          </div>
          <button type="button" aria-label="Fermer" data-bottle-model-close>×</button>
        </div>
        <div class="bottle-model-dialog__grid">
          <figure>
            <Image
              src={bouteilles15l}
              alt="Modèle de bouteille PET 1,5 litre à corps torsadé"
              widths={[480, 720, 1000]}
              sizes="(max-width: 700px) 90vw, 30vw"
            />
            <figcaption>Modèle 1</figcaption>
          </figure>
          <figure>
            <Image
              src={bouteilles15lModele1}
              alt="Modèle de bouteille PET 1,5 litre à reliefs marqués"
              widths={[480, 720, 1000]}
              sizes="(max-width: 700px) 90vw, 40vw"
            />
            <figcaption>Modèle 2</figcaption>
          </figure>
          <figure>
            <Image
              src={bouteilles15lModele2}
              alt="Modèle de bouteille PET 1,5 litre à nervures horizontales"
              widths={[480, 720, 1000]}
              sizes="(max-width: 700px) 90vw, 40vw"
            />
            <figcaption>Modèle 3</figcaption>
          </figure>
        </div>
      </div>
    </div>

    <div
      class="bottle-model-dialog"
      id="bottle-250ml-model-dialog"
      data-bottle-model-dialog
      role="dialog"
      aria-modal="true"
      aria-labelledby="bottle-250ml-model-dialog-title"
      hidden
    >
      <div class="bottle-model-dialog__inner">
        <div class="bottle-model-dialog__head">
          <div>
            <p>250 ml</p>
            <h2 id="bottle-250ml-model-dialog-title">Les trois modèles</h2>
          </div>
          <button type="button" aria-label="Fermer" data-bottle-model-close>×</button>
        </div>
        <div class="bottle-model-dialog__grid">
          <figure>
            <Image src={bouteilles250ml} alt="Modèle de bouteille PET 250 millilitres" widths={[480, 720, 1000]} sizes="(max-width: 700px) 90vw, 30vw" />
            <figcaption>Modèle 1</figcaption>
          </figure>
          <figure>
            <Image src={bouteilles250mlModele2} alt="Modèle de bouteille PET 250 millilitres à panneaux rectangulaires" widths={[480, 720, 1000]} sizes="(max-width: 700px) 90vw, 30vw" />
            <figcaption>Modèle 2</figcaption>
          </figure>
          <figure>
            <Image src={bouteilles250mlModele3} alt="Modèle de bouteille PET 250 millilitres à taille affinée" widths={[480, 720, 1000]} sizes="(max-width: 700px) 90vw, 30vw" />
            <figcaption>Modèle 3</figcaption>
          </figure>
        </div>
      </div>
    </div>

    <div
      class="bottle-model-dialog bottle-model-dialog--two"
      id="bottle-300ml-model-dialog"
      data-bottle-model-dialog
      role="dialog"
      aria-modal="true"
      aria-labelledby="bottle-300ml-model-dialog-title"
      hidden
    >
      <div class="bottle-model-dialog__inner">
        <div class="bottle-model-dialog__head">
          <div>
            <p>300 ml</p>
            <h2 id="bottle-300ml-model-dialog-title">Les deux modèles</h2>
          </div>
          <button type="button" aria-label="Fermer" data-bottle-model-close>×</button>
        </div>
        <div class="bottle-model-dialog__grid">
          <figure>
            <Image src={bouteilles300ml} alt="Modèle de bouteille PET 300 millilitres" widths={[480, 720, 1000]} sizes="(max-width: 700px) 90vw, 30vw" />
            <figcaption>Modèle 1</figcaption>
          </figure>
          <figure>
            <Image src={bouteilles300mlModele2} alt="Modèle de bouteille PET 300 millilitres à facettes" widths={[480, 720, 1000]} sizes="(max-width: 700px) 90vw, 30vw" />
            <figcaption>Modèle 2</figcaption>
          </figure>
        </div>
      </div>
    </div>

    <div
      class="bottle-model-dialog bottle-model-dialog--one"
      id="bottle-330ml-model-dialog"
      data-bottle-model-dialog
      role="dialog"
      aria-modal="true"
      aria-labelledby="bottle-330ml-model-dialog-title"
      hidden
    >
      <div class="bottle-model-dialog__inner">
        <div class="bottle-model-dialog__head">
          <div>
            <p>330 ml</p>
            <h2 id="bottle-330ml-model-dialog-title">Le modèle disponible</h2>
          </div>
          <button type="button" aria-label="Fermer" data-bottle-model-close>×</button>
        </div>
        <div class="bottle-model-dialog__grid">
          <figure>
            <Image src={bouteilles330ml} alt="Modèle de bouteille PET 330 millilitres" widths={[480, 720, 1000]} sizes="(max-width: 700px) 90vw, 40vw" />
            <figcaption>Modèle 1</figcaption>
          </figure>
        </div>
      </div>
    </div>

    <div
      class="bottle-model-dialog"
      id="bottle-1l-model-dialog"
      data-bottle-model-dialog
      role="dialog"
      aria-modal="true"
      aria-labelledby="bottle-1l-model-dialog-title"
      hidden
    >
      <div class="bottle-model-dialog__inner">
        <div class="bottle-model-dialog__head">
          <div>
            <p>1 L</p>
            <h2 id="bottle-1l-model-dialog-title">Les trois modèles</h2>
          </div>
          <button type="button" aria-label="Fermer" data-bottle-model-close>×</button>
        </div>
        <div class="bottle-model-dialog__grid">
          <figure>
            <Image
              src={bouteilles1l}
              alt="Modèle de bouteille PET 1 litre à col long"
              widths={[480, 720, 1000]}
              sizes="(max-width: 700px) 90vw, 30vw"
            />
            <figcaption>Modèle 1</figcaption>
          </figure>
          <figure>
            <Image
              src={bouteilles1lModele1}
              alt="Modèle de bouteille PET 1 litre à épaulement facetté"
              widths={[480, 720, 1000]}
              sizes="(max-width: 700px) 90vw, 30vw"
            />
            <figcaption>Modèle 2</figcaption>
          </figure>
          <figure>
            <Image
              src={bouteilles1lModele2}
              alt="Modèle de bouteille PET 1 litre à reliefs ondulés"
              widths={[480, 720, 1000]}
              sizes="(max-width: 700px) 90vw, 30vw"
            />
            <figcaption>Modèle 3</figcaption>
          </figure>
        </div>
      </div>
    </div>

    <div
      class="bottle-model-dialog"
      id="bottle-500ml-model-dialog"
      data-bottle-model-dialog
      role="dialog"
      aria-modal="true"
      aria-labelledby="bottle-500ml-model-dialog-title"
      hidden
    >
      <div class="bottle-model-dialog__inner">
        <div class="bottle-model-dialog__head">
          <div>
            <p>500 ml</p>
            <h2 id="bottle-500ml-model-dialog-title">Les cinq modèles</h2>
          </div>
          <button type="button" aria-label="Fermer" data-bottle-model-close>×</button>
        </div>
        <div class="bottle-model-dialog__grid">
          <figure>
            <Image src={bouteilles500ml} alt="Modèle de bouteille PET 500 millilitres à corps cylindrique" widths={[480, 720, 1000]} sizes="(max-width: 700px) 90vw, 30vw" />
            <figcaption>Modèle 1</figcaption>
          </figure>
          <figure>
            <Image src={bouteilles500mlModele2} alt="Modèle de bouteille PET 500 millilitres à panneaux verticaux" widths={[480, 720, 1000]} sizes="(max-width: 700px) 90vw, 30vw" />
            <figcaption>Modèle 2</figcaption>
          </figure>
          <figure>
            <Image src={bouteilles500mlModele3} alt="Modèle de bouteille PET 500 millilitres à relief torsadé" widths={[480, 720, 1000]} sizes="(max-width: 700px) 90vw, 30vw" />
            <figcaption>Modèle 3</figcaption>
          </figure>
          <figure>
            <Image src={bouteilles500mlModele4} alt="Modèle de bouteille PET 500 millilitres à reliefs ondulés" widths={[480, 720, 1000]} sizes="(max-width: 700px) 90vw, 30vw" />
            <figcaption>Modèle 4</figcaption>
          </figure>
          <figure>
            <Image src={bouteilles500mlModele5} alt="Modèle de bouteille PET 500 millilitres à vaguelettes croisées" widths={[480, 720, 1000]} sizes="(max-width: 700px) 90vw, 30vw" />
            <figcaption>Modèle 5</figcaption>
          </figure>
        </div>
      </div>
    </div>

    <section class="film-feature" aria-labelledby="film-title">
      <div class="film-feature__layout wrap">
        <div class="film-feature__copy">
          <p class="film-feature__eyebrow">Films d’emballage</p>
          <h2 id="film-title">Protéger le produit<br />jusqu’au bout</h2>
          <p>
            Des films plastiques pensés pour regrouper, stabiliser et
            conditionner vos produits.
          </p>
        </div>
        <div class="film-feature__main">
          <Image
            src={filmsStudio}
            alt="Rouleaux de film d’emballage transparent"
            widths={[960, 1280, 1536]}
            sizes="(max-width: 800px) 100vw, 58vw"
          />
        </div>
      </div>
    </section>

    <section class="caps-feature" aria-labelledby="caps-title">
      <div class="caps-feature__layout wrap">
        <div class="caps-feature__copy">
          <p class="caps-feature__eyebrow">Bouchons</p>
          <h2 id="caps-title">La couleur<br />qui vous ressemble</h2>
          <p>
            Une palette de bouchons pour adapter chaque bouteille à votre
            identité.
          </p>
        </div>
        <div class="caps-feature__main">
          <Image
            src={capsStudio}
            alt="Bouchons striés en plusieurs couleurs"
            widths={[960, 1280, 1536]}
            sizes="(max-width: 800px) 100vw, 58vw"
          />
        </div>
      </div>
    </section>

    <section class="preforms-feature" aria-labelledby="preforms-title">
      <div class="preforms-feature__layout wrap">
        <div class="preforms-feature__copy">
          <p class="preforms-feature__eyebrow">Préformes</p>
          <h2 id="preforms-title">Formats<br />et coloris</h2>
          <p>
            Des préformes PET de plusieurs hauteurs et teintes, à choisir selon
            votre projet.
          </p>
        </div>
        <div class="preforms-feature__main">
          <Image
            src={preformsStudio}
            alt="Préformes PET de différents formats et coloris"
            widths={[560, 840, 1122]}
            sizes="(max-width: 800px) 100vw, 42vw"
          />
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  .catalogue {
    overflow: hidden;
    background: var(--color-paper);
  }
  .catalogue-intro {
    padding: 84px 0 72px;
  }
  .catalogue-intro h1 {
    max-width: 8ch;
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-h1);
    font-weight: var(--fw-display);
    letter-spacing: var(--ls-display-xl);
    line-height: var(--lh-display-xl);
    }
  .catalogue-intro p {
    max-width: 35ch;
    margin: 30px 0 0;
    color: var(--color-text-soft);
    font-size: var(--text-lead);
    line-height: 1.45;
  }

  .bottle-range {
    padding-top: 7vw;
    padding-bottom: 10vw;
  }
  .bottle-range__head {
    display: grid;
    grid-template-columns: 1fr minmax(0, 1.35fr) minmax(190px, 0.55fr);
    gap: 28px;
    align-items: end;
    margin-bottom: 58px;
  }
  .bottle-range__eyebrow {
    align-self: start;
    margin: 8px 0 0;
    color: var(--color-ink);
    font-size: var(--kicker-size);
    font-weight: var(--kicker-weight);
    letter-spacing: var(--kicker-ls);
    text-transform: uppercase;
    }
  .bottle-range__head h2 {
    max-width: 11ch;
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-h2);
    font-weight: var(--fw-display);
    letter-spacing: var(--ls-display-xl);
    line-height: var(--lh-display-xl);
    }
  .bottle-range__intro {
    max-width: 23ch;
    margin: 0;
    color: var(--color-text-soft);
    font-size: 1rem;
    line-height: 1.45;
  }
  .bottle-range__carousel {
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr) 44px;
    align-items: center;
    gap: 22px;
  }
  .bottle-range__viewport {
    overflow: hidden;
  }
  .bottle-range__track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: calc((100% - 48px) / 3);
    gap: 24px;
    transition: transform 0.45s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .bottle-range__control {
    display: grid;
    width: 44px;
    height: 44px;
    place-items: center;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--color-ink);
    cursor: pointer;
    font: inherit;
    font-size: 3.2rem;
    font-weight: 300;
    line-height: 1;
    transition: opacity 0.2s ease;
  }
  .bottle-range__control:hover {
    opacity: 0.55;
  }
  .bottle-range__control:focus-visible {
    outline: 1px solid var(--color-ink);
    outline-offset: 4px;
  }
  .bottle-range__card > div {
    position: relative;
    height: clamp(280px, 32vw, 480px);
    overflow: hidden;
    background: #fff;
  }
  .bottle-range__card :global(img) {
    position: absolute;
    top: 50%;
    left: 50%;
    display: block;
    width: auto;
    height: var(--bottle-height);
    max-width: 88%;
    max-height: calc(100% - 48px);
    object-fit: contain;
    transform: translate(-50%, -50%);
  }
  .bottle-range__model-trigger {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    cursor: pointer;
    font: inherit;
    text-align: inherit;
  }
  .bottle-range__model-trigger > div {
    position: relative;
    height: clamp(280px, 32vw, 480px);
    overflow: hidden;
    background: #fff;
  }
  .bottle-range__model-trigger > span {
    display: block;
    margin-top: 4px;
    color: var(--color-text-soft);
    font-size: var(--text-small);
    text-align: center;
    transition: color 0.2s ease;
  }
  .bottle-range__model-trigger:hover > span {
    color: var(--color-ink);
  }
  .bottle-range__model-trigger:focus-visible {
    outline: 1px solid var(--color-ink);
    outline-offset: 6px;
  }
  .format-250 {
    --bottle-height: 84%;
  }
  .format-300 {
    --bottle-height: 72%;
  }
  .format-330 {
    --bottle-height: 70%;
  }
  .format-500 {
    --bottle-height: 72%;
  }
  .format-1l {
    --bottle-height: 80%;
  }
  .format-15l {
    --bottle-height: 89%;
  }
  .bottle-range__card h3 {
    margin: 15px 0 0;
    font-family: var(--font-display);
    font-size: var(--text-h3);
    font-weight: var(--fw-display);
    letter-spacing: var(--ls-display-md);
    line-height: var(--lh-display-md);
    text-align: center;
  }
  .bottle-range__note {
    margin: 32px auto 0;
    color: var(--color-text-soft);
    font-size: var(--text-small);
    text-align: center;
  }
  .bottle-range__note a {
    display: inline;
    font-size: inherit;
    color: var(--color-ink);
    white-space: nowrap; /* évite « Contactez-/nous » sur mobile */
  }
  .bottle-model-dialog {
    position: fixed;
    z-index: 20;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 20px;
    overflow-y: auto;
    background: rgb(23 52 58 / 0.45);
    backdrop-filter: blur(4px);
  }
  .bottle-model-dialog[hidden] {
    display: none;
  }
  .bottle-model-dialog__inner {
    width: min(1120px, 100%);
    max-height: min(880px, calc(100vh - 40px));
    padding: clamp(24px, 4vw, 56px);
    overflow-y: auto;
    background: var(--color-paper);
    color: var(--color-ink);
  }
  .bottle-model-dialog__head {
    position: sticky;
    top: -1px;
    z-index: 1;
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: 32px;
    margin-bottom: 24px;
    padding: 1px 0 16px;
    background: var(--color-paper);
  }
  .bottle-model-dialog__head p {
