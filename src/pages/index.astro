---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import heroProductionLine from "../assets/hero-ligne-production-nice-1l-v1.png";
import aquapurBottleSeries from "../assets/aquapur-bouteilles-serie-v1.png";
import aquapurBottleLight from "../assets/aquapur-bouteille-lumiere-v1.png";
import preformsMacro from "../assets/preformes-macro-editorial-v1.png";
import machine from "../assets/machine-atelier-mineral-v1.png";
import { rel } from "../lib/base";
---

<Layout>
  <section class="intro wrap">
    <div class="intro-side">
      <figure class="intro-material">
        <Image
          src={heroProductionLine}
          alt="Bouteilles Nice Emballage sur une ligne de production"
        />
      </figure>
    </div>
  </section>

  <section class="statement wrap">
    <p>
      Des emballages <em>fabriqués ici</em>, pour les produits du quotidien.
    </p>
  </section>

  <section class="collection wrap" id="emballages">
    <div class="collection-head">
      <span>Emballages</span><h2>Des formes pour<br />chaque projet</h2><p>
        Bouteilles, bouchons, préformes et films : des solutions adaptées à vos
        produits.
      </p>
    </div>
    <div class="collection-showcase">
      <figure>
        <Image src={aquapurBottleSeries} alt="Série de bouteilles Aquapur" />
        <figcaption><span>Bouteilles</span><span>Les formats</span></figcaption>
      </figure>
      <figure>
        <Image src={aquapurBottleLight} alt="Bouteille portée par la lumière" />
        <figcaption><span>Préformes</span><span>Le départ</span></figcaption>
      </figure>
      <figure>
        <Image src={preformsMacro} alt="Préformes PET Nice Emballage" />
        <figcaption><span>Préformes</span><span>La matière</span></figcaption>
      </figure>
    </div>
    <div class="collection-foot">
      <p>Films d’emballage, formats et solutions spécifiques sur demande.</p><a
        class="collection-link"
        href={rel("/produits")}>Découvrir les emballages</a
      >
    </div>
  </section>

  <section class="machines" id="machines">
    <div class="machines-inner wrap">
      <div class="machines-copy">
        <span>Machines</span><h2>Pour aller plus loin</h2><p>
          Des équipements pour fabriquer, conditionner et développer vos
          capacités de production.
        </p><a href={rel("/machines")}>Voir les machines</a>
      </div><figure>
        <Image src={machine} alt="Machine de fabrication industrielle" />
      </figure>
    </div>
  </section>
</Layout>

<style>
  .intro {
    min-height: 92vh;
    padding: 8vh var(--gutter) 4vw;
  }
  h1,
  h2 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 560;
    letter-spacing: -0.075em;
    line-height: 0.82;
  }
  .intro-side {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-self: stretch;
  }
  figure {
    margin: 0;
  }
  .intro-material {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    overflow: hidden;
  }
  .intro-material :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .collection-head > span,
  .machines-copy > span {
    display: block;
    font-size: 11px;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }
  .statement {
    padding: 6vw 0 6vw 0;
    text-align: center;
    border-top: 1px solid var(--color-text-soft);
    border-bottom: 1px solid var(--color-text-soft);
  }
  .statement p {
    max-width: 16ch;
    margin: auto;
    font-family: var(--font-display);
    font-size: clamp(36px, 5.1vw, 82px);
    font-weight: 560;
    letter-spacing: -0.06em;
    line-height: 0.96;
  }
  .statement em {
    color: var(--color-teal);
    font-style: normal;
  }
  .collection {
    padding-top: 6vw;
    padding-bottom: 6vw;
  }
  .collection-head {
    display: grid;
    grid-template-columns: 0.5fr 1fr 0.5fr;
    gap: 25px;
    padding-bottom: 20px;
  }
  .collection-head > span {
    margin: 8px 0 0;
  }
  .collection-head h2 {
    font-size: clamp(46px, 6vw, 95px);
    line-height: 0.86;
  }
  .collection-head p {
    align-self: end;
    max-width: 22ch;
    margin: 0;
    font-size: 14px;
    line-height: 1.4;
  }
  .collection-showcase {
    display: grid;
    grid-template-columns: 0.92fr 1.2fr 0.82fr;
    gap: 24px;
    align-items: end;
    padding-top: 55px;
  }
  .collection-showcase figure {
    overflow: hidden;
  }
  .collection-showcase figure:nth-child(1) {
    aspect-ratio: 0.82;
  }
  .collection-showcase figure:nth-child(2) {
    aspect-ratio: 1.32;
    margin-bottom: 8vw;
  }
  .collection-showcase figure:nth-child(3) {
    aspect-ratio: 0.83;
  }
  .collection-showcase :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .collection-showcase figcaption {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    padding-top: 12px;
    font-size: 12px;
    line-height: 1.2;
  }
  .collection-showcase figcaption span:last-child {
    color: var(--color-text-muted);
    text-align: right;
  }
  .collection-foot {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 30px;
    margin-top: 44px;
  }
  .collection-foot p {
    margin: 0;
    color: var(--color-text-soft);
    font-size: 0.94rem;
  }
  .collection-link {
    display: inline-flex;
    flex: none;
    font-size: 14px;
    font-weight: 700;
  }
  .machines {
    padding: 6vw 0;
    color: var(--color-ink);
  }
  .machines-inner {
    display: grid;
    grid-template-columns: 0.62fr 1.38fr;
    gap: 6vw;
    align-items: center;
  }
  .machines-copy {
    display: flex;
    flex-direction: column;
    min-height: min(40vw, 590px);
    padding: 0;
  }
  .machines-copy > span {
    margin-bottom: auto;
  }
  .machines h2 {
    max-width: 9ch;
    font-size: clamp(56px, 6.5vw, 104px);
    line-height: 0.85;
  }
  .machines-copy p {
    max-width: 28ch;
    margin: 30px 0 0;
    color: var(--color-text-muted);
    font-size: 15px;
    line-height: 1.4;
  }
  .machines-copy a {
    display: inline-flex;
    width: max-content;
    margin-top: 28px;
    font-size: 14px;
    font-weight: 700;
  }
  .machines figure {
    display: grid;
    min-height: min(44vw, 650px);
    overflow: hidden;
    background: #e7e9e7;
  }
  .machines figure :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: right center;
  }
  @media (max-width: 760px) {
    .intro {
      min-height: auto;
      display: block;
      padding: 16vh 20px 24vw;
    }
    .intro-side {
      display: block;
    }
    .intro-material {
      height: auto;
      aspect-ratio: 1.25;
    }
    .statement {
      padding: 14vw 0;
    }
    .statement p {
      font-size: 42px;
    }
    .collection { padding: 14vw 0; }
    .collection-head {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    .collection-head h2 {
      font-size: clamp(48px, 14vw, 76px);
    }
    .collection-showcase {
      display: flex;
      width: 100vw;
      margin-left: calc(50% - 50vw);
      padding: 42px 20px 0;
      overflow-x: auto;
      gap: 14px;
      scroll-snap-type: x mandatory;
    }
    .collection-showcase figure,
    .collection-showcase figure:nth-child(n) {
      min-width: 76vw;
      margin: 0;
      scroll-snap-align: start;
    }
    .collection-showcase figure:nth-child(2) {
      aspect-ratio: 0.82;
    }
    .collection-foot {
      display: block;
      margin-top: 34px;
    }
    .collection-link {
      margin-top: 18px;
    }
    .machines {
      padding: 24vw 0;
    }
    .machines-inner {
      display: block;
    }
    .machines-copy {
      min-height: auto;
      padding: 0;
    }
    .machines h2 {
      font-size: clamp(56px, 16vw, 82px);
    }
    .machines figure {
      min-height: 88vw;
      margin-top: 48px;
    }
  }
</style>
