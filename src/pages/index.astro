---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import heroProductionLine from "../assets/hero-ligne-production-nice-1l-v1.png";
import aquapurBottleSeries from "../assets/aquapur-bouteilles-serie-v1.png";
import aquapurBottleLight from "../assets/aquapur-bouteille-lumiere-v1.png";
import capDetail from "../assets/draft-cap.webp";
import realBottles from "../assets/bouteilles-reelles-sombre.png";
import preforms from "../assets/preformes-reelles-sombre-v3.png";
import caps from "../assets/bouchons-pyramide-sombre.png";
import machine from "../assets/machine-atelier-mineral-v1.png";
import aquapurBottle from "../assets/aquapur-bouteille-nice-ouverte-v2.png";
import aquapurCascade from "../assets/draft-aquapur-cascade.webp";
import { rel } from "../lib/base";
---

<Layout>
  <section class="intro wrap">
    <h1>Les formes font circuler les idées</h1>
    <div class="intro-side">
      <figure class="intro-material">
        <Image
          src={heroProductionLine}
          alt="Bouteilles Nice Emballage sur une ligne de production"
        />
      </figure>
      <div class="intro-note">
        <p>
          Nice Emballage fabrique à Ouagadougou les contenants qui accompagnent
          les produits du quotidien.
        </p><span>Depuis 16 ans · Burkina Faso</span>
      </div>
    </div>
  </section>

  <section class="hero-strip wrap" aria-label="Nice Emballage en images">
    <figure>
      <Image
        src={aquapurBottleSeries}
        alt="Série de bouteilles Aquapur"
      /><figcaption>Les contenants</figcaption>
    </figure>
    <figure>
      <Image src={aquapurBottleLight} alt="Bouteille Aquapur portée par la lumière" /><figcaption>
        La fabrication
      </figcaption>
    </figure>
    <figure>
      <Image src={capDetail} alt="Détail de matière plastique" /><figcaption>
        La matière
      </figcaption>
    </figure>
  </section>

  <section class="statement wrap">
    <p>
      Des emballages <em>fabriqués ici</em>, pour les produits qui font vivre le
      pays
    </p>
  </section>

  <section class="collection wrap" id="emballages">
    <div class="collection-head">
      <span>Emballages</span><h2>La gamme<br />Nice</h2><p>
        Bouteilles, préformes et bouchons : une sélection de formes pensées pour
        les besoins réels de vos produits.
      </p>
    </div>
    <div class="collection-grid">
      <figure class="collection-item">
        <div class="collection-media">
          <Image src={realBottles} alt="Bouteilles Nice Emballage" />
        </div><figcaption>
          <span>Bouteilles</span><span>Formats variés</span>
        </figcaption>
      </figure>
      <figure class="collection-item">
        <div class="collection-media">
          <Image src={preforms} alt="Préformes Nice Emballage" />
        </div><figcaption>
          <span>Préformes</span><span>La base</span>
        </figcaption>
      </figure>
      <figure class="collection-item">
        <div class="collection-media">
          <Image src={caps} alt="Bouchons Nice Emballage" />
        </div><figcaption>
          <span>Bouchons</span><span>La finition</span>
        </figcaption>
      </figure>
    </div>
    <a class="collection-link" href={rel("/produits")}
      >Découvrir les emballages</a
    >
  </section>

  <section class="aquapur" id="aquapur">
    <div class="aquapur-top wrap">
      <h2>Aquapur,<br />l’eau de Nice</h2><div>
        <p>
          Une marque d’eau portée par Nice Emballage. Même attention au
          contenant, une expression plus fraîche et plus sensible.
        </p><a href={rel("/aquapur")}>Découvrir Aquapur</a>
      </div>
    </div>
    <div class="aquapur-images wrap">
      <figure>
        <Image src={aquapurBottle} alt="Bouteille dans la lumière" />
      </figure><figure><Image src={aquapurCascade} alt="Cascade" /></figure>
    </div>
  </section>

  <section class="machines" id="machines">
    <div class="machines-inner wrap">
      <div class="machines-copy">
        <span>Machines</span><h2>Pour aller plus loin</h2><p>
          Des équipements pour fabriquer, conditionner et développer vos capacités
          de production.
        </p><a href={rel("/machines")}>Voir les machines</a>
      </div><figure>
        <Image src={machine} alt="Machine de fabrication industrielle" />
      </figure>
    </div>
  </section>
</Layout>

<style>
  .intro {
    min-height: 92vh;
    display: grid;
    grid-template-columns: 0.88fr 1.12fr;
    gap: 4vw;
    padding: 8vh var(--gutter) 4vw;
    align-items: center;
  }
  h1,
  h2 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 560;
    letter-spacing: -0.075em;
    line-height: 0.82;
  }
  .intro h1 {
    max-width: 8.5ch;
    font-size: clamp(72px, 9.2vw, 155px);
  }
  .intro-side {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-self: stretch;
  }
  figure {
    margin: 0;
  }
  .intro-material {
    width: 100%;
    height: min(76vh, 900px);
    overflow: hidden;
  }
  .intro-material :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .intro-note {
    width: 100%;
    margin: 36px 0 0;
  }
  .intro-note p {
    max-width: 275px;
    margin: 0 0 18px;
    font-size: 15px;
    line-height: 1.38;
  }
  .intro-note span,
  .collection-head > span,
  .machines-copy > span {
    display: block;
    font-size: 11px;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }
  .hero-strip {
    display: grid;
    grid-template-columns: 0.92fr 1.2fr 0.82fr;
    gap: 24px;
    align-items: end;
    padding-bottom: 13vw;
  }
  .hero-strip figure {
    overflow: hidden;
  }
  .hero-strip figure:nth-child(1) {
    aspect-ratio: 0.82;
  }
  .hero-strip figure:nth-child(2) {
    aspect-ratio: 1.32;
    margin-bottom: 8vw;
  }
  .hero-strip figure:nth-child(3) {
    aspect-ratio: 0.83;
  }
  .hero-strip :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero-strip figcaption,
  .collection-item figcaption {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    padding-top: 12px;
    font-size: 12px;
    line-height: 1.2;
  }
  .hero-strip figcaption {
    display: block;
  }
  .statement {
    padding: 8vw 0 15vw;
    text-align: center;
  }
  .statement p {
    max-width: 16ch;
    margin: auto;
    font-family: var(--font-display);
    font-size: clamp(36px, 5.1vw, 82px);
    font-weight: 560;
    letter-spacing: -0.06em;
    line-height: 0.96;
  }
  .statement em {
    color: var(--color-teal);
    font-style: normal;
  }
  .collection {
    padding-bottom: 15vw;
  }
  .collection-head {
    display: grid;
    grid-template-columns: 0.5fr 1fr 0.5fr;
    gap: 25px;
    padding-bottom: 20px;
  }
  .collection-head > span {
    margin: 8px 0 0;
  }
  .collection-head h2 {
    font-size: clamp(46px, 6vw, 95px);
    line-height: 0.86;
  }
  .collection-head p {
    align-self: end;
    max-width: 22ch;
    margin: 0;
    font-size: 14px;
    line-height: 1.4;
  }
  .collection-grid {
    display: grid;
    grid-template-columns: 1fr 0.75fr 1fr;
    gap: 4vw;
    padding-top: 55px;
    align-items: start;
  }
  .collection-item {
    margin: 0;
  }
  .collection-item:nth-child(2) {
    margin-top: 10vw;
  }
  .collection-media {
    overflow: hidden;
    aspect-ratio: 0.85;
    background: #1b2120;
  }
  .collection-item:nth-child(2) .collection-media {
    aspect-ratio: 0.72;
  }
  .collection-item:nth-child(3) .collection-media {
    aspect-ratio: 0.95;
  }
  .collection-media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .collection-item figcaption span:last-child {
    color: var(--color-text-muted);
    text-align: right;
  }
  .collection-link {
    display: inline-flex;
    margin-top: 44px;
    font-size: 14px;
    font-weight: 700;
  }
  .aquapur {
    position: relative;
    overflow: hidden;
    padding: 12vw 0;
    background: #aacdd6;
    color: var(--color-ink);
  }
  .aquapur::before {
    content: "AQUAPUR";
    position: absolute;
    top: 4.5vw;
    left: -0.06em;
    color: rgba(255, 255, 255, 0.34);
    font-family: var(--font-display);
    font-size: clamp(100px, 20vw, 340px);
    font-weight: 500;
    letter-spacing: -0.11em;
    line-height: 0.7;
    pointer-events: none;
  }
  .aquapur-top {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 0.7fr;
    gap: 8vw;
    align-items: end;
  }
  .aquapur-top h2 {
    font-size: clamp(52px, 7vw, 112px);
    line-height: 0.86;
  }
  .aquapur-top p {
    max-width: 28ch;
    margin: 0;
    font-size: 15px;
    line-height: 1.4;
  }
  .aquapur-top a {
    display: inline-flex;
    margin-top: 20px;
    font-size: 14px;
    font-weight: 700;
  }
  .aquapur-images {
    position: relative;
    display: grid;
    grid-template-columns: 0.7fr 1.15fr;
    gap: 3vw;
    align-items: end;
    margin-top: 10vw;
  }
  .aquapur-images figure {
    overflow: hidden;
  }
  .aquapur-images figure:first-child {
    width: 75%;
    justify-self: end;
    aspect-ratio: 0.7;
  }
  .aquapur-images figure:last-child {
    aspect-ratio: 1.35;
  }
  .aquapur-images :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .machines {
    padding: 12vw 0;
    color: var(--color-ink);
  }
  .machines-inner {
    display: grid;
    grid-template-columns: 0.62fr 1.38fr;
    gap: 6vw;
    align-items: center;
  }
  .machines-copy {
    display: flex;
    flex-direction: column;
    min-height: min(40vw, 590px);
    padding: 0;
  }
  .machines-copy > span {
    margin-bottom: auto;
  }
  .machines h2 {
    max-width: 9ch;
    font-size: clamp(56px, 6.5vw, 104px);
    line-height: 0.85;
  }
  .machines-copy p {
    max-width: 28ch;
    margin: 30px 0 0;
    color: var(--color-text-muted);
    font-size: 15px;
    line-height: 1.4;
  }
  .machines-copy a {
    display: inline-flex;
    width: max-content;
    margin-top: 28px;
    font-size: 14px;
    font-weight: 700;
  }
  .machines figure {
    display: grid;
    min-height: min(44vw, 650px);
    overflow: hidden;
    background: #e7e9e7;
  }
  .machines figure :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: right center;
  }
  @media (max-width: 760px) {
    .intro {
      min-height: auto;
      display: block;
      padding: 16vh 20px 24vw;
    }
    .intro h1 {
      font-size: clamp(68px, 18vw, 108px);
    }
    .intro-side {
      display: block;
    }
    .intro-material {
      height: 70vh;
      margin-top: 42px;
    }
    .intro-note {
      margin-top: 24px;
    }
    .hero-strip {
      display: flex;
      width: 100vw;
      margin-left: calc(50% - 50vw);
      padding: 0 20px 26vw;
      overflow-x: auto;
      gap: 14px;
      scroll-snap-type: x mandatory;
    }
    .hero-strip figure,
    .hero-strip figure:nth-child(n) {
      min-width: 76vw;
      margin: 0;
      scroll-snap-align: start;
    }
    .hero-strip figure:nth-child(2) {
      aspect-ratio: 0.82;
    }
    .statement {
      padding: 10vw 0 27vw;
    }
    .statement p {
      font-size: 42px;
    }
    .collection {
      padding-bottom: 28vw;
    }
    .collection-head {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    .collection-head h2 {
      font-size: clamp(48px, 14vw, 76px);
    }
    .collection-grid {
      display: flex;
      width: 100vw;
      margin-left: calc(50% - 50vw);
      padding: 42px 20px 0;
      overflow-x: auto;
      gap: 16px;
      scroll-snap-type: x mandatory;
    }
    .collection-item,
    .collection-item:nth-child(n) {
      min-width: 78vw;
      margin: 0;
      scroll-snap-align: start;
    }
    .collection-item:nth-child(n) .collection-media {
      aspect-ratio: 0.88;
    }
    .aquapur {
      padding: 28vw 0 22vw;
    }
    .aquapur::before {
      top: 6vw;
      font-size: 28vw;
    }
    .aquapur-top {
      grid-template-columns: 1fr;
      gap: 26px;
    }
    .aquapur-top h2 {
      font-size: clamp(52px, 15vw, 78px);
    }
    .aquapur-images {
      width: 100vw;
      margin: 16vw 0 0 calc(50% - 50vw);
      padding-left: 20px;
      grid-template-columns: 0.7fr 1fr;
      gap: 14px;
    }
    .aquapur-images figure:first-child {
      width: 100%;
    }
    .aquapur-images figure:last-child {
      margin-right: -15%;
    }
    .machines {
      padding: 24vw 0;
    }
    .machines-inner {
      display: block;
    }
    .machines-copy {
      min-height: auto;
      padding: 0;
    }
    .machines h2 {
      font-size: clamp(56px, 16vw, 82px);
    }
    .machines figure {
      min-height: 88vw;
      margin-top: 48px;
    }
  }
</style>
